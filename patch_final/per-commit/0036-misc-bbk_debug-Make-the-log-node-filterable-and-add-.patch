From d630a0f48176f53485443d7b5c54d847e794db3d Mon Sep 17 00:00:00 2001
From: Zhiyu722 <Zhiyu722@users.noreply.github.com>
Date: Sun, 13 Sep 2026 12:48:00 +0800
Subject: [PATCH 36/71] misc: bbk_debug: Make the log node filterable and add
 an elevator pin node

The ring buffer on this ROM is flooded with SELinux audit records from adb shell
probing sysfs, so a plain snapshot of the oldest few kilobytes is useless.  The
log node now takes a pattern on write and returns only the matching lines, and
"clear" empties the buffer first, which is what makes a live capture of a
driver failure possible at all.

/proc/eebbk_pins reports the electrical state that is otherwise invisible
without debugfs: the levels and directions of gpio 21/23/24/25/26/29 (the
elevator's clock output, enable, boost, id, direction and sleep pins) and the
rate of gcc_gp2_clk.  Both nodes exist only in CONFIG_BBK_DEBUG_BRINGUP builds.

Signed-off-by: Zhiyu722 <Zhiyu722@users.noreply.github.com>
---
 drivers/misc/bbk_debug.c | 221 +++++++++++++++++++++++++++++++++++----
 1 file changed, 200 insertions(+), 21 deletions(-)

diff --git a/drivers/misc/bbk_debug.c b/drivers/misc/bbk_debug.c
index f54277505..8be9d402d 100755
--- a/drivers/misc/bbk_debug.c
+++ b/drivers/misc/bbk_debug.c
@@ -3,14 +3,20 @@
  *
  * On this ROM the kernel log is not readable from adb shell: /dev/kmsg is root
  * only, the syslog syscall is restricted and logd's kernel buffer is disabled,
- * so a driver that fails to probe leaves no trace we can see.  This node
- * publishes the whole ring buffer to any reader, which is what
+ * so a driver that fails to probe leaves no trace we can see.  These nodes
+ * publish the ring buffer and the state of the elevator pins to any reader,
+ * which is what
  *
- *     adb shell cat /proc/eebbk_kmsg | grep -i m1120
+ *     adb shell "echo clear > /proc/eebbk_kmsg"      # drop the audit spam
+ *     adb shell "echo vib_pwm > /proc/eebbk_kmsg"    # keep only these lines
+ *     adb shell cat /proc/eebbk_kmsg
  *
- * needs during bring-up.  It is compiled in only when CONFIG_BBK_DEBUG_BRINGUP
- * is set, together with the SELinux permissive override in
- * security/selinux/hooks.c, so the normal image is unaffected.
+ * needs during bring-up.  Everything is compiled in only when
+ * CONFIG_BBK_DEBUG_BRINGUP is set, together with the SELinux permissive
+ * override in security/selinux/hooks.c, so the normal image is unaffected.
+ *
+ * The log node is world writable on purpose: adb shell is not root here, and
+ * a 0600 node would be useless.  It exists in bring-up images only.
  *
  * SPDX-License-Identifier: GPL-2.0
  */
@@ -21,10 +27,19 @@
 #include <linux/fs.h>
 #include <linux/uaccess.h>
 #include <linux/syslog.h>
+#include <linux/slab.h>
+#include <linux/seq_file.h>
+#include <linux/gpio.h>
+#include <linux/gpio/consumer.h>
+#include <linux/clk.h>
+#include <linux/clk-provider.h>
 
 #ifndef SYSLOG_ACTION_READ_ALL
 #define SYSLOG_ACTION_READ_ALL	3
 #endif
+#ifndef SYSLOG_ACTION_READ_CLEAR
+#define SYSLOG_ACTION_READ_CLEAR	4
+#endif
 
 /*
  * do_syslog()'s fourth argument.  check_syslog_permissions() lets a caller that
@@ -40,25 +55,139 @@
 #define SYSLOG_FROM_PROC	1
 #endif
 
-#define BBK_KMSG_NAME	"eebbk_kmsg"
+#define BBK_KMSG_NAME		"eebbk_kmsg"
+#define BBK_PINS_NAME		"eebbk_pins"
 
-static ssize_t bbk_kmsg_read(struct file *file, char __user *ubuf,
-			     size_t count, loff_t *ppos)
+#define BBK_KMSG_MAX		(1024 * 1024)
+#define BBK_KMSG_PATTERN_MAX	32
+
+static char *bbk_kmsg_buf;
+static char bbk_kmsg_pattern[BBK_KMSG_PATTERN_MAX];
+static DEFINE_MUTEX(bbk_kmsg_lock);
+
+/* reading the whole ring buffer through copy_to_user needs a kernel pointer */
+static int bbk_kmsg_snapshot(char *dst, size_t size)
+{
+	mm_segment_t oldfs;
+	int len;
+
+	oldfs = get_fs();
+	set_fs(KERNEL_DS);
+	len = do_syslog(SYSLOG_ACTION_READ_ALL, dst, size, SYSLOG_FROM_PROC);
+	set_fs(oldfs);
+	return len;
+}
+
+static void bbk_kmsg_drop(void)
+{
+	mm_segment_t oldfs;
+	char junk[256];
+
+	oldfs = get_fs();
+	set_fs(KERNEL_DS);
+	do_syslog(SYSLOG_ACTION_READ_CLEAR, junk, sizeof(junk), SYSLOG_FROM_PROC);
+	set_fs(oldfs);
+}
+
+/*
+ * Writing a pattern selects which lines the next read returns; "clear" empties
+ * the ring buffer so that the next read only shows what happened after it.
+ */
+static ssize_t bbk_kmsg_write(struct file *file, const char __user *ubuf,
+			      size_t count, loff_t *ppos)
 {
-	int ret;
+	char tmp[BBK_KMSG_PATTERN_MAX];
+	size_t n = count;
 
-	if (!count)
+	if (!n)
 		return 0;
+	if (n > sizeof(tmp) - 1)
+		n = sizeof(tmp) - 1;
+	if (copy_from_user(tmp, ubuf, n))
+		return -EFAULT;
+	tmp[n] = 0;
+	while (n && (tmp[n - 1] == '\n' || tmp[n - 1] == '\r'))
+		tmp[--n] = 0;
+
+	mutex_lock(&bbk_kmsg_lock);
+	if (!strcmp(tmp, "clear")) {
+		bbk_kmsg_drop();
+		bbk_kmsg_pattern[0] = 0;
+	} else {
+		memcpy(bbk_kmsg_pattern, tmp, n + 1);
+	}
+	mutex_unlock(&bbk_kmsg_lock);
+	return count;
+}
+
+static ssize_t bbk_kmsg_read(struct file *file, char __user *ubuf,
+			     size_t count, loff_t *ppos)
+{
+	char line[1024];
+	char pat[BBK_KMSG_PATTERN_MAX];
+	char *r, *w, *end;
+	int len, total, ret = 0;
 
 	/*
 	 * READ_ALL always hands back the whole ring buffer, so without this a
 	 * reader like cat would loop for ever.  One snapshot per open is what a
 	 * bring-up node needs.
 	 */
-	if (*ppos)
+	if (!count || *ppos)
 		return 0;
 
-	ret = do_syslog(SYSLOG_ACTION_READ_ALL, ubuf, count, SYSLOG_FROM_PROC);
+	mutex_lock(&bbk_kmsg_lock);
+	if (!bbk_kmsg_buf) {
+		/* 1 MB is too big for kmalloc on this device, so use vmalloc */
+		bbk_kmsg_buf = vzalloc(BBK_KMSG_MAX);
+		if (!bbk_kmsg_buf) {
+			mutex_unlock(&bbk_kmsg_lock);
+			return -ENOMEM;
+		}
+	}
+	memcpy(pat, bbk_kmsg_pattern, sizeof(pat));
+
+	len = bbk_kmsg_snapshot(bbk_kmsg_buf, BBK_KMSG_MAX - 1);
+	if (len < 0) {
+		mutex_unlock(&bbk_kmsg_lock);
+		return len;
+	}
+	bbk_kmsg_buf[len] = 0;
+
+	/* filter in place: the write cursor never passes the read cursor */
+	r = bbk_kmsg_buf;
+	w = bbk_kmsg_buf;
+	end = bbk_kmsg_buf + len;
+	while (r < end) {
+		char *nl = memchr(r, '\n', end - r);
+		size_t whole = nl ? (size_t)(nl - r) + 1 : (size_t)(end - r);
+		size_t l = whole;
+
+		if (l > sizeof(line) - 1)
+			l = sizeof(line) - 1;
+		memcpy(line, r, l);
+		line[l] = 0;
+		if (!pat[0] || strstr(line, pat)) {
+			memmove(w, r, whole);
+			w += whole;
+		}
+		r += whole;
+	}
+
+	total = w - bbk_kmsg_buf;
+	if (total > (int)count) {
+		/* hand back the newest lines that fit in the reader's buffer */
+		int skip = total - (int)count;
+
+		memmove(bbk_kmsg_buf, bbk_kmsg_buf + skip, count);
+		total = count;
+	}
+	if (total && copy_to_user(ubuf, bbk_kmsg_buf, total))
+		ret = -EFAULT;
+	else
+		ret = total;
+
+	mutex_unlock(&bbk_kmsg_lock);
 	if (ret > 0)
 		*ppos += ret;
 	return ret;
@@ -67,23 +196,73 @@ static ssize_t bbk_kmsg_read(struct file *file, char __user *ubuf,
 static const struct file_operations bbk_kmsg_fops = {
 	.owner	= THIS_MODULE,
 	.read	= bbk_kmsg_read,
+	.write	= bbk_kmsg_write,
 	.llseek	= no_llseek,
 };
 
-static int __init bbk_debug_init(void)
+/*
+ * /proc/eebbk_pins - the electrical state of the elevator, which is otherwise
+ * invisible: debugfs is not mounted and adb shell is not root.  The pins and
+ * their polarity are the ones the device tree gives soc:bbk_vib_pwm; gpio21 is
+ * the pin that carries the gcc_gp2 clock when the "vib_pwm_active" pinctrl
+ * state is selected, which is how the motor gets its drive waveform.
+ */
+static int bbk_pins_show(struct seq_file *m, void *v)
 {
-	struct proc_dir_entry *e;
+	static const int pins[] = { 21, 23, 24, 25, 26, 29 };
+	struct clk *c;
+	int i;
 
-	e = proc_create(BBK_KMSG_NAME, 0444, NULL, &bbk_kmsg_fops);
-	if (!e) {
-		pr_err("bbk_debug: cannot create /proc/%s\n", BBK_KMSG_NAME);
-		return -ENOMEM;
+	for (i = 0; i < ARRAY_SIZE(pins); i++) {
+		struct gpio_desc *dsc = gpio_to_desc(pins[i]);
+
+		if (!dsc) {
+			seq_printf(m, "gpio%-3d not a gpio here\n", pins[i]);
+			continue;
+		}
+		seq_printf(m, "gpio%-3d raw=%d %s\n", pins[i],
+			   gpiod_get_raw_value_cansleep(dsc),
+			   gpiod_get_direction(dsc) ? "in" : "out");
 	}
-	pr_info("bbk_debug: /proc/%s ready (bring-up build)\n", BBK_KMSG_NAME);
+	seq_puts(m, "dir=26 (0 up, 1 down) enable=23 (0 on) boost=24 (1 on) "
+		    "sleep=29 (1 on) id=25\n");
+
+	c = clk_get(NULL, "gcc_gp2_clk");
+	if (IS_ERR(c)) {
+		seq_printf(m, "gcc_gp2_clk not found (%ld)\n", PTR_ERR(c));
+	} else {
+		seq_printf(m, "gcc_gp2_clk rate=%lu enabled=%d\n",
+			   clk_get_rate(c), __clk_is_enabled(c));
+		clk_put(c);
+	}
+	return 0;
+}
+
+static int bbk_pins_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, bbk_pins_show, NULL);
+}
+
+static const struct file_operations bbk_pins_fops = {
+	.owner		= THIS_MODULE,
+	.open		= bbk_pins_open,
+	.read		= seq_read,
+	.llseek		= seq_lseek,
+	.release	= single_release,
+};
+
+static int __init bbk_debug_init(void)
+{
+	if (!proc_create(BBK_KMSG_NAME, 0666, NULL, &bbk_kmsg_fops))
+		pr_err("bbk_debug: cannot create /proc/%s\n", BBK_KMSG_NAME);
+	if (!proc_create(BBK_PINS_NAME, 0444, NULL, &bbk_pins_fops))
+		pr_err("bbk_debug: cannot create /proc/%s\n", BBK_PINS_NAME);
+	pr_info("bbk_debug: /proc/%s and /proc/%s ready (bring-up build)\n",
+		BBK_KMSG_NAME, BBK_PINS_NAME);
 	return 0;
 }
 late_initcall(bbk_debug_init);
 
 MODULE_AUTHOR("EEBBK S6 kernel reconstruction");
-MODULE_DESCRIPTION("Bring-up kernel log node for the EEBBK S6");
+MODULE_DESCRIPTION("Bring-up kernel log and elevator pin nodes for the EEBBK S6");
 MODULE_LICENSE("GPL v2");
