From 2c17d551c78d1586d7c1b8eaa92d525997e018d9 Mon Sep 17 00:00:00 2001
From: Zhiyu722 <Zhiyu722@users.noreply.github.com>
Date: Sun, 13 Sep 2026 09:53:26 +0800
Subject: [PATCH 25/73] misc: Add bring-up helpers behind
 CONFIG_BBK_DEBUG_BRINGUP

On this ROM a driver that fails to probe leaves no trace we can see from adb:
/dev/kmsg is root only, the syslog syscall is restricted and logd's kernel
buffer is disabled, so "why did my sensor not bind?" cannot be answered from the
device.  Worse, the vendor sysfs nodes are readable only by the vendor's own
SELinux domains, so even the elevator motor cannot be exercised by hand.

Add two opt-in bring-up helpers, both compiled in only when
CONFIG_BBK_DEBUG_BRINGUP is set so that a normal image is unaffected:

  /proc/eebbk_kmsg  a world readable view of the whole kernel ring buffer.  It
                    calls do_syslog() with the /proc source flag, which
                    check_syslog_permissions() accepts without CAP_SYSLOG.
  permissive boot   security/selinux/hooks.c starts SELinux in permissive mode
                    instead of the configured mode, so adb shell can read
                    /sys/devices/platform/soc/soc:bbk_vib_pwm and
                    /sys/devices/platform/bbk_hall_core.

Neither is enabled in the factory configuration; only a build that sets the
symbol gets them, which is what the bring-up image in dist/ uses.

Signed-off-by: Zhiyu722 <Zhiyu722@users.noreply.github.com>
---
 drivers/misc/Kconfig     |  9 +++++
 drivers/misc/Makefile    |  1 +
 drivers/misc/bbk_debug.c | 81 ++++++++++++++++++++++++++++++++++++++++
 security/selinux/hooks.c | 11 ++++++
 4 files changed, 102 insertions(+)
 create mode 100755 drivers/misc/bbk_debug.c

diff --git a/drivers/misc/Kconfig b/drivers/misc/Kconfig
index de3a0a18f..eff4870bf 100644
--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -638,3 +638,12 @@ config VIB_PWM
 	  not part of this tree.
 
 
+config BBK_DEBUG_BRINGUP
+	bool "EEBBK bring-up helpers (world readable kernel log, permissive SELinux)"
+	default n
+	help
+	  Bring-up only: adds /proc/eebbk_kmsg, a world readable view of the kernel
+	  ring buffer, and starts SELinux in permissive mode so that adb shell can
+	  read the vendor sysfs nodes.  Do not enable this in a shipping image.
+
+
diff --git a/drivers/misc/Makefile b/drivers/misc/Makefile
index 421664edb..33e32a8d4 100644
--- a/drivers/misc/Makefile
+++ b/drivers/misc/Makefile
@@ -92,3 +92,4 @@ obj-$(CONFIG_OKL4_USER_VIPC)    += okl4-vipc.o
 obj-$(CONFIG_OKL4_GUEST)        += okl4-panic.o
 obj-$(CONFIG_OKL4_LINK_SHBUF)    += okl4-link-shbuf.o
 obj-$(CONFIG_VIB_PWM)		+= gpio_pwm.o
+obj-$(CONFIG_BBK_DEBUG_BRINGUP)	+= bbk_debug.o
diff --git a/drivers/misc/bbk_debug.c b/drivers/misc/bbk_debug.c
new file mode 100755
index 000000000..2bb4b9075
--- /dev/null
+++ b/drivers/misc/bbk_debug.c
@@ -0,0 +1,81 @@
+/*
+ * Bring-up aid for the EEBBK S6 (P20H130).
+ *
+ * On this ROM the kernel log is not readable from adb shell: /dev/kmsg is root
+ * only, the syslog syscall is restricted and logd's kernel buffer is disabled,
+ * so a driver that fails to probe leaves no trace we can see.  This node
+ * publishes the whole ring buffer to any reader, which is what
+ *
+ *     adb shell cat /proc/eebbk_kmsg | grep -i m1120
+ *
+ * needs during bring-up.  It is compiled in only when CONFIG_BBK_DEBUG_BRINGUP
+ * is set, together with the SELinux permissive override in
+ * security/selinux/hooks.c, so the normal image is unaffected.
+ *
+ * SPDX-License-Identifier: GPL-2.0
+ */
+#include <linux/module.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/proc_fs.h>
+#include <linux/fs.h>
+#include <linux/uaccess.h>
+#include <linux/syslog.h>
+
+#ifndef SYSLOG_ACTION_READ_ALL
+#define SYSLOG_ACTION_READ_ALL	3
+#endif
+
+/*
+ * do_syslog()'s fourth argument.  check_syslog_permissions() lets a caller that
+ * claims to come from /proc through without CAP_SYSLOG:
+ *
+ *	if (source == SYSLOG_FROM_PROC && type != SYSLOG_ACTION_OPEN)
+ *		goto ok;
+ *
+ * which is exactly what this node needs; what remains is security_syslog(),
+ * and the bring-up build runs SELinux permissive.
+ */
+#ifndef SYSLOG_FROM_PROC
+#define SYSLOG_FROM_PROC	1
+#endif
+
+#define BBK_KMSG_NAME	"eebbk_kmsg"
+
+static ssize_t bbk_kmsg_read(struct file *file, char __user *ubuf,
+			     size_t count, loff_t *ppos)
+{
+	int ret;
+
+	if (!count)
+		return 0;
+
+	ret = do_syslog(SYSLOG_ACTION_READ_ALL, ubuf, count, SYSLOG_FROM_PROC);
+	if (ret > 0)
+		*ppos += ret;
+	return ret;
+}
+
+static const struct file_operations bbk_kmsg_fops = {
+	.owner	= THIS_MODULE,
+	.read	= bbk_kmsg_read,
+	.llseek	= no_llseek,
+};
+
+static int __init bbk_debug_init(void)
+{
+	struct proc_dir_entry *e;
+
+	e = proc_create(BBK_KMSG_NAME, 0444, NULL, &bbk_kmsg_fops);
+	if (!e) {
+		pr_err("bbk_debug: cannot create /proc/%s\n", BBK_KMSG_NAME);
+		return -ENOMEM;
+	}
+	pr_info("bbk_debug: /proc/%s ready (bring-up build)\n", BBK_KMSG_NAME);
+	return 0;
+}
+late_initcall(bbk_debug_init);
+
+MODULE_AUTHOR("EEBBK S6 kernel reconstruction");
+MODULE_DESCRIPTION("Bring-up kernel log node for the EEBBK S6");
+MODULE_LICENSE("GPL v2");
diff --git a/security/selinux/hooks.c b/security/selinux/hooks.c
index 041c556ac..51ada60db 100644
--- a/security/selinux/hooks.c
+++ b/security/selinux/hooks.c
@@ -6957,7 +6957,18 @@ static __init int selinux_init(void)
 	printk(KERN_INFO "SELinux:  Initializing.\n");
 
 	memset(&selinux_state, 0, sizeof(selinux_state));
+#ifdef CONFIG_BBK_DEBUG_BRINGUP
+	/*
+	 * EEBBK S6 bring-up build: start permissive so that adb shell can read
+	 * the vendor sysfs nodes (/sys/.../soc:bbk_vib_pwm, /sys/.../bbk_hall_core)
+	 * and /proc entries, which the vendor policy only allows to its own
+	 * domains.  Normal builds keep the configured mode.
+	 */
+	enforcing_set(&selinux_state, 0);
+	pr_info("SELinux:  EEBBK bring-up build, starting in permissive mode\n");
+#else
 	enforcing_set(&selinux_state, selinux_enforcing_boot);
+#endif
 	selinux_state.checkreqprot = selinux_checkreqprot_boot;
 	selinux_ss_init(&selinux_state.ss);
 	selinux_avc_init(&selinux_state.avc);
