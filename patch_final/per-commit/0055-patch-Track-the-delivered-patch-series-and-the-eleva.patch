+++					return BBK_FRONT_S5K4H7("LiteArray");
+++				if (buf[5] == 0x09) {
+++					if (len < 7)
+++						return BBK_FRONT_S5K4H7(
+++							"LiteArray");
+++					if (buf[6] == 0xa0) {
