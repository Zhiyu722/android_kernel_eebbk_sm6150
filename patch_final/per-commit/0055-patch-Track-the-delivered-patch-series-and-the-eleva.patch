+-+++	unsigned int		time_ms;
+-+++	unsigned int		pre_time;
+-+++	bool			is_subsection;
+-+++	unsigned long		freq;
+-+++	int			enable;		/* 1 up, 2 down, else idle */
+-+++	int			camera_state;
