+-+++static ssize_t vib_pwm_camera_state_store(struct device *dev, struct device_attribute *attr,
+-+++					  const char *buf, size_t count)
+-+++{
+-+++	int state = 0;
+-+++
+-+++	dev_info(dev, "%s: want to set camera_state: %s", __func__, buf);
+-+++	if (!buf || !count)
