+++		pr_err("[LYQ-damon-hall]:read %s failed,%ld\n",
+++		       CALI_PATH_COUNT, PTR_ERR(f));
+++		return;
+++	}
+++	n = kernel_read(f, buf, sizeof(buf) - 1, &f->f_pos);
+++	filp_close(f, NULL);
+++	if (n <= 0) {
+++		pr_err("[LYQ-damon-hall]:read %s failed,%ld\n",
+++		       CALI_PATH_COUNT, (long)n);
+++		return;
+++	}
+++	if (sscanf(buf, "%u-%u", &up, &all) == 2) {
