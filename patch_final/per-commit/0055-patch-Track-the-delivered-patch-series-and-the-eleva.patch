+++	if (buf[4] != 0xd0)
+++		return BBK_FRONT_S5K4H7("unknown");
+++	if (len < 6)
+++		return BBK_FRONT_S5K4H7("Truly");
+++	if (buf[5] != 0x09)
+++		return BBK_FRONT_S5K4H7("unknown");
+++	if (len < 7)
+++		return BBK_FRONT_S5K4H7("Truly");
+++	if (buf[6] != 0xa0)
+++		return BBK_FRONT_S5K4H7("unknown");
+++	if (len < 0xc)
+++		return BBK_FRONT_S5K4H7("Truly");
