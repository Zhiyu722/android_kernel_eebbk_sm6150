+-++ struct vib_pwm {
+-++ 	struct device		*dev;
+-++ 	struct mutex		lock;
+-++@@ -144,32 +220,59 @@ struct vib_pwm {
+-++ 	int			dir_gpio;
+-++ 	int			id_gpio;
+-++ 	struct wakeup_source	wakeup;
+-+++	bool			ws_active;
+-++ 	wait_queue_head_t	wait;
