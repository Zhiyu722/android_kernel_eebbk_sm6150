++h->is_move = 0;
++clk_disable(h->pwm_clk);
++h->sub_phase = 0;
++gpio(boost)=0; gpio(enable)=1; gpio(sleep)=0;         /* 无 msleep */
++queue_delayed_work_on(WORK_CPU_UNBOUND(8), h->wq, &h->work, 1);   /* 1 jiffy 后 delay_func */
++return HRTIMER_NORESTART;
