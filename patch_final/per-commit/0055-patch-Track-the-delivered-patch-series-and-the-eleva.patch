+ 		length = avc_has_perm(&selinux_state,
diff --git a/patch+++/0028-input-misc-mxm1120-Accept-the-id-this-board-actually.patch b/patch+++/0028-input-misc-mxm1120-Accept-the-id-this-board-actually.patch
