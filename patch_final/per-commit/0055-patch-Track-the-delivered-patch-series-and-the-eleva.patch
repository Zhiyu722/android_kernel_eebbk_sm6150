+++		pr_err("[LYQ-damon-hall]:open %s failed %ld\n", path, PTR_ERR(f));
+++		return -1;
+++	}
+++	wrote = __kernel_write(f, blob, size, &f->f_pos);
+++	filp_close(f, NULL);
+++	if (wrote != size) {
+++		pr_err("[LYQ-damon-hall]:write %s failed %ld\n", path, (long)wrote);
