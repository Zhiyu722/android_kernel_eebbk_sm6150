+++	else if (d->pos == M1120_POS_DOWN)
+++		strlcpy(d->hall.name, "down-mxm1120", sizeof(d->hall.name));
+++	else
+++		strlcpy(d->hall.name, "mid-mxm1120", sizeof(d->hall.name));
+++
+++	return bbk_hall_core_register_device(&d->hall);
+++}
