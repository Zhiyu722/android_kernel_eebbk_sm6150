++# SPDX-License-Identifier: GPL-2.0
++obj-$(CONFIG_INPUT_HALL)		+= bbk_hall_core.o
+diff --git a/drivers/input/hall/bbk_hall_core.c b/drivers/input/hall/bbk_hall_core.c
+new file mode 100755
