+++		return -1;
+++	mhall_data->delay = ms < HALL_DELAY_MIN ? HALL_DELAY_MIN : ms;
+++	pr_info("[LYQ-damon-hall]:%s delay %d\n", __func__, mhall_data->delay);
+++	return 0;
+++}
+++EXPORT_SYMBOL_GPL(bbk_hall_core_set_delay);
