++```c
++struct vib_pwm *h = dev_get_drvdata(dev);
++int id;
++if (h && h->boost_gpio /* 偏移 0x10 ！厂商 bug，见下 */) {
++    printk("\0016[LYQ-damon-vib]:Entry vib_pwm_id_show & get vib id\n");
++    id = gpiod_get_raw_value(gpio_to_desc(h->id_gpio));   /* 偏移 0x20，probe 配成输入 */
