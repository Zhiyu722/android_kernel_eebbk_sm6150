+++    gpiod_direction_output_raw(gpio_to_desc(h->enable_gpio), 1);
+++    gpiod_direction_output_raw(gpio_to_desc(h->sleep_gpio), 0);
+++    return count;                        /* 不碰时钟、不碰 hrtimer */
+++}
