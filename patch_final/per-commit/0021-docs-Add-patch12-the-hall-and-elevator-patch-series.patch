++  case 1:
++  case 2: if (h->move_count <= 2)               vib_pwm_state_move_sate(h->target_state, 0); break;
++  case 7: if (h->move_count <= 1 || still_flag) vib_pwm_state_move_sate(7, 0); break;
++  default: vib_pwm_state_move_sate(-1, 0); break;
