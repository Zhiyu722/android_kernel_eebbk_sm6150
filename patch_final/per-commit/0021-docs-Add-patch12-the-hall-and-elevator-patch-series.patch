++static int __maybe_unused vib_pwm_suspend(struct device *dev)
++{
++	struct vib_pwm *d = dev_get_drvdata(dev);
++
++	if (d && !d->moving && d->pinctrl && !IS_ERR(d->pins_suspend))
++		pinctrl_select_state(d->pinctrl, d->pins_suspend);
++	return 0;
++}
