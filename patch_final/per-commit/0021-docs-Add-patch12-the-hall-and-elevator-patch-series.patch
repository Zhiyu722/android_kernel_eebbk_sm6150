++static int vib_pwm_remove(struct platform_device *pdev)
++{
++	struct vib_pwm *d = platform_get_drvdata(pdev);
++
++	if (d) {
++		vib_pwm_motor_stop(d);
++		wakeup_source_destroy(&d->wakeup);
++	}
++	sysfs_remove_groups(&pdev->dev.kobj, vib_pwm_groups);
++	vib_pwm_dev = NULL;
++	return 0;
++}
