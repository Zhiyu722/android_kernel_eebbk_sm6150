+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Zhiyu722 <Zhiyu722@users.noreply.github.com>
+Date: Sat, 12 Sep 2026 21:50:01 +0800
+Subject: [PATCH] input: misc: Add the iSentek IST8801 hall switch driver
+
+The EEBBK S6 carries iSentek IST8801 3D hall-effect switches on i2c 0x18 and
+0x1b (dt compatibles isentek,ist8801-0/-1/-2).  The vendor driver is built into
+the factory kernel and its source is not part of this tree, so the register map
+and the access protocol had to be recovered by disassembling the factory boot
+image, whose kallsyms still carries the symbol names (ist8801_i2c_probe,
+ist8801_i2c_read_block, ist8801_set_operation_mode, ist8801_hall_getdata, ...).
+
+  i2c write: buf[0] = reg, buf[1] = value, i2c_master_send(client, buf, 2)
+  i2c read : msg[0] = {addr, 0, 1, &reg}, msg[1] = {addr, I2C_M_RD, len, buf}
+             (len <= 0x11; serialised by a driver-global mutex)
+
+  reg 0x01 control, 0x07 control, 0x08 operation mode (0x00 powerdown /
+  0x40 measurement / 0x80 start), 0x09 device id, 0x10 five-byte data block,
+  0x20 control, 0x40 status, 0x54 status
+
+The device is brought up in measurement mode and exports data/enable/delay/
+vendor sysfs attributes; reading "data" triggers one measurement.  The BBK hall
+core and the elevator driver that consume it are still to be written.
+
+Signed-off-by: Zhiyu722 <Zhiyu722@users.noreply.github.com>
+---
+ drivers/input/misc/Kconfig   |  10 +
+ drivers/input/misc/Makefile  |   1 +
+ drivers/input/misc/ist8801.c | 449 +++++++++++++++++++++++++++++++++++
+ 3 files changed, 460 insertions(+)
+ create mode 100755 drivers/input/misc/ist8801.c
+
+diff --git a/drivers/input/misc/Kconfig b/drivers/input/misc/Kconfig
+index e0c7a6f35..cb7922e1b 100644
+--- a/drivers/input/misc/Kconfig
++++ b/drivers/input/misc/Kconfig
+@@ -890,3 +890,13 @@ config INPUT_HISI_POWERKEY
+ 	  module will be called hisi_powerkey.
+ 
+ endif
++
++config INPUT_IST8801
++	bool "iSentek IST8801 3D hall switch"
++	depends on I2C
++	help
++	  Say Y here to support the iSentek IST8801 3D hall-effect switch used as
++	  the BBK hall sensor (dt: isentek,ist8801-0/-1/-2).
++
++	  The driver was reconstructed from the vendor kernel binary because the
++	  vendor sources are not part of this tree.
+diff --git a/drivers/input/misc/Makefile b/drivers/input/misc/Makefile
+index 137da08f7..769323298 100644
+--- a/drivers/input/misc/Makefile
++++ b/drivers/input/misc/Makefile
+@@ -85,3 +85,4 @@ obj-$(CONFIG_INPUT_WM831X_ON)		+= wm831x-on.o
+ obj-$(CONFIG_INPUT_XEN_KBDDEV_FRONTEND)	+= xen-kbdfront.o
+ obj-$(CONFIG_INPUT_YEALINK)		+= yealink.o
+ obj-$(CONFIG_INPUT_IDEAPAD_SLIDEBAR)	+= ideapad_slidebar.o
++obj-$(CONFIG_INPUT_IST8801)	+= ist8801.o
+diff --git a/drivers/input/misc/ist8801.c b/drivers/input/misc/ist8801.c
+new file mode 100755
+index 000000000..cb4b317a7
+--- /dev/null
++++ b/drivers/input/misc/ist8801.c
+@@ -0,0 +1,449 @@
++/*
++ * iSentek IST8801 3D hall-effect switch driver for the EEBBK S6 (P20H130).
++ *
++ * Reconstructed from the vendor kernel binary in the factory boot image: the
++ * vendor source of this driver is not part of this tree, so the register map
++ * and the access protocol were recovered by disassembling the factory Image
++ * (its kallsyms still carries the symbol names).
++ *
++ * Recovered symbols
++ *   ist8801_i2c_probe, ist8801_i2c_read_block, ist8801_set_operation_mode,
++ *   ist8801_set_detection_mode, ist8801_hall_enable, ist8801_hall_getdata,
++ *   ist8801_get_data, ist8801_get_id, ist8801_reset_device,
++ *   ist8801_dump_reg, ist8801_i2c_suspend/resume, ist8801_ranges_1/_2
++ *
++ * I2C protocol
++ *   write: buf[0] = reg, buf[1] = value, i2c_master_send(client, buf, 2),
++ *          serialised by the global ist8801_i2c_mutex.
++ *   read : ist8801_i2c_read_block(data, reg, buf, len), len <= 0x11,
++ *          i2c_transfer with {addr,0,1,&reg} then {addr,I2C_M_RD,len,buf}.
++ *
++ * Register map (addresses seen in the disassembly)
++ *   0x01  control             written 0x00 (also on the reset path)
++ *   0x07  control             written 0x01
++ *   0x08  operation mode      written 0x00 powerdown / 0x40 mode / 0x80 start
++ *   0x09  device id           read twice with msleep(20) in between
++ *   0x10  5-byte data block   "ist8801: data [%02X, %02X, %02X, %02X, %02X]"
++ *   0x20  control             written 0x00 / 0x02
++ *   0x40  status/mode         read 1 byte before and after a measurement
++ *   0x54  status              read 1 byte
++ *   0x00..0x13                dumped by ist8801_dump_reg
++ *
++ * Data path
++ *   ist8801_hall_enable -> set_detection_mode + set_operation_mode
++ *   ist8801_hall_getdata: read 0x40; write {0x08,0x80};
++ *                         usleep_range(2000, 2500); read 5 bytes @0x10;
++ *                         read 0x40 again; log "z=%6d, zc=%6d, t=%6d, t25=%6d"
++ *
++ * SPDX-License-Identifier: GPL-2.0
++ */
++#include <linux/module.h>
++#include <linux/i2c.h>
++#include <linux/of.h>
++#include <linux/of_device.h>
++#include <linux/slab.h>
++#include <linux/delay.h>
++#include <linux/mutex.h>
++#include <linux/sysfs.h>
++#include <linux/string.h>
++
++#define IST8801_DRV_NAME	"ist8801"
++
++#define IST8801_REG_CTRL1	0x01
++#define IST8801_REG_CTRL2	0x07
++#define IST8801_REG_OPMODE	0x08
++#define IST8801_REG_DID		0x09
++#define IST8801_REG_DATA	0x10
++#define IST8801_REG_CTRL3	0x20
++#define IST8801_REG_STATUS1	0x40
++#define IST8801_REG_STATUS2	0x54
++
++#define IST8801_OP_POWERDOWN	0x00
++#define IST8801_OP_MODE		0x40
++#define IST8801_OP_START	0x80
++
++#define IST8801_DATA_LEN	5
++#define IST8801_MAX_RD		0x11
++
++struct ist8801_data {
++	struct i2c_client	*client;
++	struct device		*dev;
++	struct mutex		lock;
++	u8			did;
++	bool			enabled;
++	unsigned int		delay_ms;
++	u32			data_range;
++	u32			bias_support;
++	u32			bias_ratio;
++	char			line[128];
++};
++
++static DEFINE_MUTEX(ist8801_i2c_mutex);
++
++static int ist8801_i2c_read_block(struct ist8801_data *d, u8 reg, u8 *buf, u16 len)
++{
++	struct i2c_msg msgs[2];
++	int ret;
++
++	if (!d || !d->client)
++		return -EINVAL;
++	if (!len || len > IST8801_MAX_RD) {
++		dev_err(d->dev, "%s: bad length %u\n", __func__, len);
++		return -EINVAL;
++	}
++
++	mutex_lock(&ist8801_i2c_mutex);
++	msgs[0].addr = d->client->addr;
++	msgs[0].flags = 0;
++	msgs[0].len = 1;
++	msgs[0].buf = &reg;
++	msgs[1].addr = d->client->addr;
++	msgs[1].flags = I2C_M_RD;
++	msgs[1].len = len;
++	msgs[1].buf = buf;
++	ret = i2c_transfer(d->client->adapter, msgs, 2);
++	mutex_unlock(&ist8801_i2c_mutex);
++
++	if (ret < 0) {
++		dev_err(d->dev, "%s: i2c read reg 0x%02x failed (%d)\n",
++			__func__, reg, ret);
++		return -EIO;
++	}
++	return 0;
++}
++
++static int ist8801_i2c_write_block(struct ist8801_data *d, u8 reg, u8 val)
++{
++	u8 buf[2] = { reg, val };
++	int ret;
++
++	if (!d || !d->client)
++		return -EINVAL;
++
++	mutex_lock(&ist8801_i2c_mutex);
++	ret = i2c_master_send(d->client, buf, sizeof(buf));
++	mutex_unlock(&ist8801_i2c_mutex);
++
++	if (ret < 0) {
++		dev_err(d->dev, "%s: i2c write 0x%02x=0x%02x failed (%d)\n",
++			__func__, reg, val, ret);
++		return -EIO;
++	}
++	return 0;
++}
++
++static int ist8801_reset_device(struct ist8801_data *d)
++{
++	int ret = ist8801_i2c_write_block(d, IST8801_REG_CTRL1, 0x00);
++
++	msleep(20);	/* the factory probe sleeps 20ms before re-reading the id */
++	return ret;
++}
++
++static int ist8801_get_id(struct ist8801_data *d, u8 *id)
++{
++	return ist8801_i2c_read_block(d, IST8801_REG_DID, id, 1);
++}
++
++static int ist8801_set_operation_mode(struct ist8801_data *d, u8 op)
++{
++	int ret;
++
++	switch (op) {
++	case IST8801_OP_START:
++		ret = ist8801_i2c_write_block(d, IST8801_REG_OPMODE, IST8801_OP_START);
++		break;
++	case IST8801_OP_MODE:
++		ret = ist8801_i2c_write_block(d, IST8801_REG_OPMODE, IST8801_OP_MODE);
++		if (!ret)
++			ret = ist8801_i2c_write_block(d, IST8801_REG_CTRL3, 0x02);
++		break;
++	default:
++		ret = ist8801_i2c_write_block(d, IST8801_REG_OPMODE, IST8801_OP_POWERDOWN);
++		if (!ret)
++			ret = ist8801_i2c_write_block(d, IST8801_REG_CTRL3, 0x00);
++		break;
++	}
++	return ret;
++}
++
++static int ist8801_set_detection_mode(struct ist8801_data *d, bool enable)
++{
++	return ist8801_i2c_write_block(d, IST8801_REG_CTRL1, enable ? 0x01 : 0x00);
++}
++
++static int ist8801_get_data(struct ist8801_data *d, u8 *raw)
++{
++	int ret;
++
++	ret = ist8801_i2c_read_block(d, IST8801_REG_STATUS1, raw, 1);
++	if (ret)
++		return ret;
++
++	ret = ist8801_set_operation_mode(d, IST8801_OP_START);
++	if (ret)
++		return ret;
++
++	usleep_range(2000, 2500);
++
++	ret = ist8801_i2c_read_block(d, IST8801_REG_DATA, raw, IST8801_DATA_LEN);
++	if (ret)
++		return ret;
++
++	dev_dbg(d->dev, "%s: data [%02X, %02X, %02X, %02X, %02X]\n", __func__,
++		raw[0], raw[1], raw[2], raw[3], raw[4]);
++
++	if (!(raw[0] & 0x01))
++		dev_dbg(d->dev, "%s: st1(0x%02X) is not DRDY.\n", __func__, raw[0]);
++
++	return 0;
++}
++
++/* one full sample, formatted the way the factory driver formatted it */
++static int ist8801_refresh(struct ist8801_data *d)
++{
++	u8 raw[IST8801_DATA_LEN];
++	u8 st2 = 0;
++	s16 z, t;
++	int ret;
++
++	mutex_lock(&d->lock);
++	ret = ist8801_get_data(d, raw);
++	mutex_unlock(&d->lock);
++	if (ret)
++		return ret;
++
++	z = (s16)((raw[2] << 8) | raw[1]);
++	t = (s16)((raw[4] << 8) | raw[3]);
++
++	ist8801_i2c_read_block(d, IST8801_REG_STATUS2, &st2, 1);
++
++	scnprintf(d->line, sizeof(d->line),
++		  "ist8801 [%x], z=%6d, zc=%6d, t=%6d, t25=%6d.",
++		  d->client->addr, z, z, t, t);
++	return 0;
++}
++
++static ssize_t data_show(struct device *dev, struct device_attribute *attr, char *buf)
++{
++	struct ist8801_data *d = dev_get_drvdata(dev);
++
++	ist8801_refresh(d);
++	return scnprintf(buf, PAGE_SIZE, "%s\n", d->line);
++}
++
++static ssize_t enable_show(struct device *dev, struct device_attribute *attr, char *buf)
++{
++	struct ist8801_data *d = dev_get_drvdata(dev);
++
++	return scnprintf(buf, PAGE_SIZE, "%d\n", d->enabled ? 1 : 0);
++}
++
++static ssize_t enable_store(struct device *dev, struct device_attribute *attr,
++			    const char *buf, size_t count)
++{
++	struct ist8801_data *d = dev_get_drvdata(dev);
++	unsigned long v;
++
++	if (kstrtoul(buf, 0, &v))
++		return -EINVAL;
++
++	mutex_lock(&d->lock);
++	d->enabled = !!v;
++	ist8801_set_detection_mode(d, d->enabled);
++	ist8801_set_operation_mode(d, d->enabled ? IST8801_OP_MODE
++						 : IST8801_OP_POWERDOWN);
++	mutex_unlock(&d->lock);
++	return count;
++}
++
++static ssize_t delay_show(struct device *dev, struct device_attribute *attr, char *buf)
++{
++	struct ist8801_data *d = dev_get_drvdata(dev);
++
++	return scnprintf(buf, PAGE_SIZE, "%u\n", d->delay_ms);
++}
++
++static ssize_t delay_store(struct device *dev, struct device_attribute *attr,
++			   const char *buf, size_t count)
++{
++	struct ist8801_data *d = dev_get_drvdata(dev);
++	unsigned long v;
++
++	if (kstrtoul(buf, 0, &v))
++		return -EINVAL;
++	d->delay_ms = (unsigned int)v;
++	return count;
++}
++
++static ssize_t vendor_show(struct device *dev, struct device_attribute *attr, char *buf)
++{
++	return scnprintf(buf, PAGE_SIZE, "isentek\n");
++}
++
++static DEVICE_ATTR_RO(data);
++static DEVICE_ATTR_RW(enable);
++static DEVICE_ATTR_RW(delay);
++static DEVICE_ATTR_RO(vendor);
++
++static struct attribute *ist8801_attrs[] = {
++	&dev_attr_data.attr,
++	&dev_attr_enable.attr,
++	&dev_attr_delay.attr,
++	&dev_attr_vendor.attr,
++	NULL,
++};
++ATTRIBUTE_GROUPS(ist8801);
++
++static int ist8801_parse_dt(struct ist8801_data *d)
++{
++	struct device_node *np = d->dev->of_node;
++	u32 v;
++
++	d->delay_ms = 100;
++	d->data_range = 0;
++
++	if (np && !of_property_read_u32(np, "data-range", &v))
++		d->data_range = v;
++	if (np && !of_property_read_u32(np, "hall,bias_support", &v))
++		d->bias_support = v;
++	if (np && !of_property_read_u32(np, "hall,bias-ratio", &v))
++		d->bias_ratio = v;
++	else
++		d->bias_ratio = 0x5a;
++
++	dev_info(d->dev, "%s : data-range is 0x%x\n", __func__, d->data_range);
++	return 0;
++}
++
++static int ist8801_i2c_probe(struct i2c_client *client,
++			     const struct i2c_device_id *id)
++{
++	struct ist8801_data *d;
++	u8 did = 0;
++	int ret;
++
++	d = devm_kzalloc(&client->dev, sizeof(*d), GFP_KERNEL);
++	if (!d)
++		return -ENOMEM;
++
++	d->client = client;
++	d->dev = &client->dev;
++	mutex_init(&d->lock);
++	i2c_set_clientdata(client, d);
++	dev_set_drvdata(&client->dev, d);
++	strlcpy(d->line, "ist8801: no data yet", sizeof(d->line));
++
++	if (!i2c_check_functionality(client->adapter, I2C_FUNC_I2C)) {
++		dev_err(d->dev, "%s : i2c_check_functionality was failed\n", __func__);
++		return -EOPNOTSUPP;
++	}
++
++	ist8801_parse_dt(d);
++
++	ret = ist8801_reset_device(d);
++	if (ret) {
++		dev_err(d->dev, "%s : ist8801_reset_device fail\n", __func__);
++		return ret;
++	}
++
++	ret = ist8801_get_id(d, &did);
++	if (ret) {
++		dev_err(d->dev, "%s : read IST8801_REG_DID failed(%d)\n",
++			__func__, ret);
++		return ret;
++	}
++	d->did = did;
++
++	dev_info(d->dev, "%s: ist8801 at 0x%02x, device id 0x%02x\n",
++		 __func__, client->addr, did);
++
++	ret = devm_device_add_groups(d->dev, ist8801_groups);
++	if (ret) {
++		dev_err(d->dev, "%s: sysfs_create_group failed(%d)\n", __func__, ret);
++		return ret;
++	}
++
++	d->enabled = true;
++	ist8801_set_detection_mode(d, true);
++	ist8801_set_operation_mode(d, IST8801_OP_MODE);
++	ist8801_refresh(d);
++	dev_info(d->dev, "%s: %s\n", __func__, d->line);
++
++	return 0;
++}
++
++static int ist8801_i2c_remove(struct i2c_client *client)
++{
++	struct ist8801_data *d = i2c_get_clientdata(client);
++
++	if (!d)
++		return 0;
++	mutex_lock(&d->lock);
++	d->enabled = false;
++	ist8801_set_operation_mode(d, IST8801_OP_POWERDOWN);
++	mutex_unlock(&d->lock);
++	return 0;
++}
++
++static int ist8801_i2c_suspend(struct device *dev)
++{
++	struct ist8801_data *d = dev_get_drvdata(dev);
++
++	if (!d)
++		return 0;
++	mutex_lock(&d->lock);
++	ist8801_set_operation_mode(d, IST8801_OP_POWERDOWN);
++	mutex_unlock(&d->lock);
++	return 0;
++}
++
++static int ist8801_i2c_resume(struct device *dev)
++{
++	struct ist8801_data *d = dev_get_drvdata(dev);
++
++	if (!d)
++		return 0;
++	mutex_lock(&d->lock);
++	if (d->enabled)
++		ist8801_set_operation_mode(d, IST8801_OP_MODE);
++	mutex_unlock(&d->lock);
++	return 0;
++}
++
++static const struct dev_pm_ops ist8801_pm_ops = {
++	SET_SYSTEM_SLEEP_PM_OPS(ist8801_i2c_suspend, ist8801_i2c_resume)
++};
++
++static const struct of_device_id ist8801_match[] = {
++	{ .compatible = "isentek,ist8801-0" },
++	{ .compatible = "isentek,ist8801-1" },
++	{ .compatible = "isentek,ist8801-2" },
++	{ }
++};
++MODULE_DEVICE_TABLE(of, ist8801_match);
++
++static const struct i2c_device_id ist8801_id[] = {
++	{ "ist8801_0", 0 },
++	{ "ist8801_1", 1 },
++	{ "ist8801_2", 2 },
++	{ }
++};
++MODULE_DEVICE_TABLE(i2c, ist8801_id);
++
++static struct i2c_driver ist8801_i2c_driver = {
++	.driver = {
++		.name		= IST8801_DRV_NAME,
++		.owner		= THIS_MODULE,
++		.pm		= &ist8801_pm_ops,
++		.of_match_table	= of_match_ptr(ist8801_match),
++	},
++	.probe		= ist8801_i2c_probe,
++	.remove		= ist8801_i2c_remove,
++	.id_table	= ist8801_id,
++};
++module_i2c_driver(ist8801_i2c_driver);
++
++MODULE_AUTHOR("EEBBK S6 kernel reconstruction");
++MODULE_DESCRIPTION("iSentek IST8801 3D hall switch (reconstructed from the factory binary)");
++MODULE_LICENSE("GPL v2");
diff --git a/patch12/0002-input-misc-Add-the-Magnachip-MXM1120-hall-switch-dri.patch b/patch12/0002-input-misc-Add-the-Magnachip-MXM1120-hall-switch-dri.patch
new file mode 100644
index 000000000..59b903a14
--- /dev/null
+++ b/patch12/0002-input-misc-Add-the-Magnachip-MXM1120-hall-switch-dri.patch
@@ -0,0 +1,668 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Zhiyu722 <Zhiyu722@users.noreply.github.com>
+Date: Sat, 12 Sep 2026 22:40:54 +0800
+Subject: [PATCH] input: misc: Add the Magnachip MXM1120 hall switch driver
+
+The EEBBK S6 carries two Magnachip MXM1120 hall switches on i2c 0x0c and 0x0f
+(dt compatibles magnachip,mxm1120,down and magnachip,mxm1120,up) that drive the
+elevator camera.  The vendor driver is built into the factory kernel and its
+source is not part of this tree, so the register map, the access protocol and
+the measurement decoding had to be recovered by disassembling the factory boot
+image, whose kallsyms still carries the symbol names (m1120_i2c_drv_probe,
+m1120_i2c_set_reg, m1120_measure, m1120_set_operation_mode, m1120_irq_handler,
+m1120_update_interrupt_threshold, m1120_misc_dev_ioctl, m1120_data_show, ...).
+
+  i2c write: one message carrying {reg, value}
+  i2c read : i2c_smbus_read_i2c_block_data(client, reg, len, buf)
+
+  reg 0x00  device id / status, one byte, expected 0x9c; bits 7:6 hold the two
+            high bits of the field in 10-bit mode
+  reg 0x01  control, written 0x00 and then (value & 0x7f)
+  reg 0x07  control, written 0x01
+  reg 0x08  operation mode, 0x40 selects measurement, 0x00 is powerdown
+  reg 0x10  three-byte measurement block: status (bit 0 is DRDY), low bits,
+            high bits
+
+The probe sequence is taken verbatim from the vendor binary: 0x07 = 0x01, read
+0x00 and require 0x9c, 0x00 = 0x40, 0x01 = 0x00, 0x08 = 0x40, then a
+read-modify-write of 0x01 with 0x7f and of 0x08 with 0xfe.
+
+Each measurement is decoded into a signed 16-bit value and reported on ABS_X of
+an input device named m1120_up / m1120_down, which is exactly what the factory
+kernel created (it also set ABS_X to -32768..32767), plus data/enable/delay/
+vendor sysfs attributes.
+
+The properties the vendor driver parsed are honoured: magnachip,init-interval
+(zero becomes one, and one unit is the vendor's 20 ms work delay),
+magnachip,use-interrupt, magnachip,gpio-int and magnachip,use-hrtimer.  The
+factory DT sets only magnachip,init-interval = <1>, so the sensor is polled
+every 20 ms; the interrupt and hrtimer modes are reported in the log, but fall
+back to polling because they are not wired up here.
+
+The factory config already enables CONFIG_INPUT_MXM1120_UP and
+CONFIG_INPUT_MXM1120_DOWN, so the new hidden CONFIG_INPUT_MXM1120 that builds
+this driver is selected instead of configured, and the sensor position comes
+from the DT compatible.  Checked by seeding .config from
+arch/arm64/configs/h130_factory.config and running olddefconfig, which yields
+CONFIG_INPUT_MXM1120=y alongside CONFIG_INPUT_MXM1120_UP=y and
+CONFIG_INPUT_MXM1120_DOWN=y.
+
+Signed-off-by: Zhiyu722 <Zhiyu722@users.noreply.github.com>
+---
+ drivers/input/misc/Kconfig   |  35 +++
+ drivers/input/misc/Makefile  |   1 +
+ drivers/input/misc/mxm1120.c | 553 +++++++++++++++++++++++++++++++++++
+ 3 files changed, 589 insertions(+)
+ create mode 100644 drivers/input/misc/mxm1120.c
+
+diff --git a/drivers/input/misc/Kconfig b/drivers/input/misc/Kconfig
+index cb7922e1b..6ff29dba6 100644
+--- a/drivers/input/misc/Kconfig
++++ b/drivers/input/misc/Kconfig
+@@ -900,3 +900,38 @@ config INPUT_IST8801
+ 
+ 	  The driver was reconstructed from the vendor kernel binary because the
+ 	  vendor sources are not part of this tree.
++
++config INPUT_MXM1120
++	bool
++	depends on I2C
++	help
++	  Hidden option that builds the Magnachip MXM1120 hall switch driver.  It
++	  is selected by the board options below; the sensor position (up, down or
++	  middle) is taken from the device tree compatible, not from the config.
++
++	  The driver was reconstructed from the vendor kernel binary because the
++	  vendor sources are not part of this tree.
++
++config INPUT_MXM1120_UP
++	bool "Magnachip MXM1120 up hall switch"
++	depends on I2C
++	select INPUT_MXM1120
++	help
++	  Say Y here to support the up Magnachip MXM1120 hall-effect switch
++	  (dt: magnachip,mxm1120,up).
++
++config INPUT_MXM1120_DOWN
++	bool "Magnachip MXM1120 down hall switch"
++	depends on I2C
++	select INPUT_MXM1120
++	help
++	  Say Y here to support the down Magnachip MXM1120 hall-effect switch
++	  (dt: magnachip,mxm1120,down).
++
++config INPUT_MXM1120_MIDDLE
++	bool "Magnachip MXM1120 middle hall switch"
++	depends on I2C
++	select INPUT_MXM1120
++	help
++	  Say Y here to support the middle Magnachip MXM1120 hall-effect switch
++	  (dt: magnachip,mxm1120,middle).
+diff --git a/drivers/input/misc/Makefile b/drivers/input/misc/Makefile
+index 769323298..a6a270b00 100644
+--- a/drivers/input/misc/Makefile
++++ b/drivers/input/misc/Makefile
+@@ -86,3 +86,4 @@ obj-$(CONFIG_INPUT_XEN_KBDDEV_FRONTEND)	+= xen-kbdfront.o
+ obj-$(CONFIG_INPUT_YEALINK)		+= yealink.o
+ obj-$(CONFIG_INPUT_IDEAPAD_SLIDEBAR)	+= ideapad_slidebar.o
+ obj-$(CONFIG_INPUT_IST8801)	+= ist8801.o
++obj-$(CONFIG_INPUT_MXM1120)	+= mxm1120.o
+diff --git a/drivers/input/misc/mxm1120.c b/drivers/input/misc/mxm1120.c
+new file mode 100644
+index 000000000..a2ad8fd05
+--- /dev/null
++++ b/drivers/input/misc/mxm1120.c
+@@ -0,0 +1,553 @@
++/*
++ * Magnachip MXM1120 hall / magnetic sensor driver for the EEBBK S6 (P20H130).
++ *
++ * Reconstructed from the vendor kernel binary in the factory boot image: the
++ * vendor sources are not part of this tree, so the register map, the access
++ * protocol and the measurement decoding were recovered by disassembling the
++ * factory Image (its kallsyms still carries the symbol names).
++ *
++ * Recovered symbols
++ *   m1120_i2c_drv_probe (x2: up/down), m1120_i2c_set_reg(_up), m1120_measure(_up),
++ *   m1120_irq_handler, m1120_set_enable, m1120_set_delay, m1120_set_operation_mode,
++ *   m1120_update_interrupt_threshold(_up), m1120_misc_dev_ioctl, m1120_data_show,
++ *   m1120_dump_show, m1120_input_dev_init
++ *
++ * I2C protocol
++ *   write: buf[0] = reg, buf[1] = value, one i2c_msg (len 2) via i2c_transfer()
++ *   read : i2c_smbus_read_i2c_block_data(client, reg, len, buf)
++ *
++ * Register map
++ *   0x00  device id / status   read 1 byte, expected 0x9c on a healthy part;
++ *                              bits 7:6 are the two high bits of the field in
++ *                              10-bit mode
++ *   0x01  control              written 0x00, then (value & 0x7f)
++ *   0x07  control              written 0x01
++ *   0x08  operation mode       written 0x40 (measurement), (value & 0xfe)
++ *   0x10  3-byte measurement   buf[0] = status (bit 0 = DRDY), buf[1] = low
++ *                              bits, buf[2] = high bits
++ *   0x00..0x0a                 dumped by the vendor's debug path
++ *
++ * Init sequence recovered from m1120_i2c_drv_probe
++ *   write 0x07 = 0x01
++ *   read  0x00 -> must be 0x9c
++ *   write 0x00 = 0x40
++ *   write 0x01 = 0x00
++ *   write 0x08 = 0x40
++ *   write 0x01 = (old & 0x7f)
++ *   write 0x08 = (old & 0xfe)
++ *
++ * Measurement decoding recovered from m1120_measure
++ *   10-bit mode (flags & 2 == 0):  v = buf[1] | ((buf[2] >> 6) << 8), sign
++ *                                  extended from bit 9
++ *    8-bit mode (flags & 2 != 0):  v = buf[2] & 0x7f,  sign extended from bit 7
++ *   the result is a signed 16-bit value, which is what the factory's input
++ *   device reported on ABS_X (-32768..32767)
++ *
++ * The sensor is exposed as an input device named "m1120_up" / "m1120_down"
++ * (exactly the names the factory kernel created, see /proc/bus/input/devices)
++ * plus sysfs attributes for enable/delay/data/vendor.
++ *
++ * SPDX-License-Identifier: GPL-2.0
++ */
++#include <linux/module.h>
++#include <linux/i2c.h>
++#include <linux/of.h>
++#include <linux/of_gpio.h>
++#include <linux/slab.h>
++#include <linux/delay.h>
++#include <linux/mutex.h>
++#include <linux/sysfs.h>
++#include <linux/input.h>
++#include <linux/workqueue.h>
++#include <linux/regulator/consumer.h>
++
++#define M1120_DRV_NAME		"mxm1120"
++
++#define M1120_REG_ID		0x00
++#define M1120_REG_CTRL1		0x01
++#define M1120_REG_CTRL2		0x07
++#define M1120_REG_OPMODE	0x08
++#define M1120_REG_DATA		0x10
++
++#define M1120_ID_EXPECT		0x9c
++#define M1120_DATA_LEN		3
++#define M1120_OP_MEASUREMENT	0x40
++
++enum m1120_pos {
++	M1120_POS_UP = 0,
++	M1120_POS_DOWN,
++	M1120_POS_MIDDLE,
++};
++
++struct m1120_data {
++	struct i2c_client	*client;
++	struct device		*dev;
++	struct input_dev	*input;
++	struct mutex		lock;
++	struct delayed_work	work;
++	struct regulator	*vdd;
++	struct regulator	*vddio;
++	int			reset_gpio;
++	enum m1120_pos		pos;
++	u8			device_id;
++	bool			enabled;
++	bool			ten_bit;
++	bool			use_interrupt;
++	bool			use_hrtimer;
++	unsigned int		init_interval;
++	unsigned int		delay_ms;
++	char			line[128];
++	s16			last;
++};
++
++static int m1120_i2c_set_reg(struct m1120_data *d, u8 reg, u8 val)
++{
++	u8 buf[2] = { reg, val };
++	struct i2c_msg msg = {
++		.addr	= d->client->addr,
++		.flags	= 0,
++		.len	= sizeof(buf),
++		.buf	= buf,
++	};
++	int ret;
++
++	/* [RE] the vendor helper issues a single message carrying reg+value */
++	ret = i2c_transfer(d->client->adapter, &msg, 1);
++	if (ret < 0) {
++		dev_err(d->dev, "%s: i2c write 0x%02x=0x%02x failed (%d)\n",
++			__func__, reg, val, ret);
++		return ret;
++	}
++	return 0;
++}
++
++static int m1120_read_block(struct m1120_data *d, u8 reg, u8 len, u8 *buf)
++{
++	int ret = i2c_smbus_read_i2c_block_data(d->client, reg, len, buf);
++
++	if (ret < 0) {
++		dev_err(d->dev, "%s: i2c read 0x%02x failed (%d)\n",
++			__func__, reg, ret);
++		return ret;
++	}
++	return 0;
++}
++
++static int m1120_get_id(struct m1120_data *d, u8 *id)
++{
++	return m1120_read_block(d, M1120_REG_ID, 1, id);
++}
++
++static int m1120_init_device(struct m1120_data *d)
++{
++	u8 v = 0;
++	int ret;
++
++	/* [RE] the exact sequence the vendor probe used */
++	ret = m1120_i2c_set_reg(d, M1120_REG_CTRL2, 0x01);
++	if (ret)
++		return ret;
++
++	ret = m1120_get_id(d, &d->device_id);
++	if (ret)
++		return ret;
++	if (d->device_id != M1120_ID_EXPECT) {
++		dev_err(d->dev, "%s: current device id(0x%02X) is not M1120 device id(0x%02X)\n",
++			__func__, d->device_id, M1120_ID_EXPECT);
++		return -ENODEV;
++	}
++
++	ret = m1120_i2c_set_reg(d, M1120_REG_ID, 0x40);
++	if (ret)
++		return ret;
++	ret = m1120_i2c_set_reg(d, M1120_REG_CTRL1, 0x00);
++	if (ret)
++		return ret;
++	ret = m1120_i2c_set_reg(d, M1120_REG_OPMODE, M1120_OP_MEASUREMENT);
++	if (ret)
++		return ret;
++
++	/* read-modify-write of 0x01 and 0x08, as in the vendor probe */
++	ret = m1120_read_block(d, M1120_REG_CTRL1, 1, &v);
++	if (!ret)
++		ret = m1120_i2c_set_reg(d, M1120_REG_CTRL1, v & 0x7f);
++	if (ret)
++		return ret;
++	ret = m1120_read_block(d, M1120_REG_OPMODE, 1, &v);
++	if (!ret)
++		ret = m1120_i2c_set_reg(d, M1120_REG_OPMODE, v & 0xfe);
++
++	dev_info(d->dev, "%s: initializing device was success (id 0x%02x)\n",
++		 __func__, d->device_id);
++	return ret;
++}
++
++static int m1120_set_operation_mode(struct m1120_data *d, bool measure)
++{
++	u8 v = 0;
++	int ret;
++
++	ret = m1120_read_block(d, M1120_REG_OPMODE, 1, &v);
++	if (ret)
++		return ret;
++	v = measure ? (v | M1120_OP_MEASUREMENT) : (v & ~M1120_OP_MEASUREMENT);
++	return m1120_i2c_set_reg(d, M1120_REG_OPMODE, v);
++}
++
++/* one measurement; returns the signed field value in *value */
++static int m1120_measure(struct m1120_data *d, s16 *value)
++{
++	u8 buf[M1120_DATA_LEN];
++	u8 extra = 0;
++	int v;
++
++	int ret = m1120_read_block(d, M1120_REG_DATA, M1120_DATA_LEN, buf);
++	if (ret)
++		return ret;
++
++	/* [RE] "damon st1(0x%02X) is not DRDY" - bit 0 of the status byte */
++	if (!(buf[0] & 0x01))
++		dev_dbg(d->dev, "%s: damon st1(0x%02X) is not DRDY\n", __func__, buf[0]);
++
++	if (d->ten_bit) {
++		/* [RE] 10-bit mode: low byte plus two bits from the status byte */
++		ret = m1120_read_block(d, M1120_REG_ID, 1, &extra);
++		if (ret)
++			return ret;
++		v = buf[1] | (((extra >> 6) & 0x3) << 8);
++		v = (v & 0x200) ? (v | ~0x3ff) : v;	/* sign extend bit 9 */
++	} else {
++		/* [RE] 8-bit mode */
++		v = buf[2] & 0x7f;
++		v = (buf[2] & 0x80) ? (v | ~0x7f) : v;	/* sign extend bit 7 */
++	}
++
++	*value = (s16)v;
++	dev_dbg(d->dev, "%s: raw = %d\n", __func__, *value);
++	return 0;
++}
++
++static void m1120_work(struct work_struct *work)
++{
++	struct m1120_data *d = container_of(to_delayed_work(work),
++					    struct m1120_data, work);
++	s16 value;
++	int ret;
++
++	mutex_lock(&d->lock);
++	ret = m1120_measure(d, &value);
++	if (!ret) {
++		d->last = value;
++		if (d->input)
++			input_report_abs(d->input, ABS_X, value);
++		if (d->input)
++			input_sync(d->input);
++		scnprintf(d->line, sizeof(d->line), "m1120 [%s] raw = %d\n",
++			  d->pos == M1120_POS_UP ? "up" :
++			  (d->pos == M1120_POS_DOWN ? "down" : "middle"), value);
++	}
++	if (d->enabled)
++		schedule_delayed_work(&d->work, msecs_to_jiffies(d->delay_ms));
++	mutex_unlock(&d->lock);
++}
++
++/* ------------------------------------------------------------------ sysfs -- */
++
++static ssize_t data_show(struct device *dev, struct device_attribute *attr, char *buf)
++{
++	struct m1120_data *d = dev_get_drvdata(dev);
++
++	return scnprintf(buf, PAGE_SIZE, "%s", d->line);
++}
++
++static ssize_t enable_show(struct device *dev, struct device_attribute *attr, char *buf)
++{
++	struct m1120_data *d = dev_get_drvdata(dev);
++
++	return scnprintf(buf, PAGE_SIZE, "%d\n", d->enabled ? 1 : 0);
++}
++
++static ssize_t enable_store(struct device *dev, struct device_attribute *attr,
++			    const char *buf, size_t count)
++{
++	struct m1120_data *d = dev_get_drvdata(dev);
++	unsigned long v;
++
++	if (kstrtoul(buf, 0, &v))
++		return -EINVAL;
++
++	mutex_lock(&d->lock);
++	d->enabled = !!v;
++	if (d->enabled) {
++		m1120_set_operation_mode(d, true);
++		schedule_delayed_work(&d->work, 0);
++	} else {
++		cancel_delayed_work(&d->work);
++		m1120_set_operation_mode(d, false);
++	}
++	mutex_unlock(&d->lock);
++	return count;
++}
++
++static ssize_t delay_show(struct device *dev, struct device_attribute *attr, char *buf)
++{
++	struct m1120_data *d = dev_get_drvdata(dev);
++
++	return scnprintf(buf, PAGE_SIZE, "%u\n", d->delay_ms);
++}
++
++static ssize_t delay_store(struct device *dev, struct device_attribute *attr,
++			   const char *buf, size_t count)
++{
++	struct m1120_data *d = dev_get_drvdata(dev);
++	unsigned long v;
++
++	if (kstrtoul(buf, 0, &v))
++		return -EINVAL;
++	d->delay_ms = (unsigned int)v;
++	return count;
++}
++
++static ssize_t vendor_show(struct device *dev, struct device_attribute *attr, char *buf)
++{
++	return scnprintf(buf, PAGE_SIZE, "magnachip\n");
++}
++
++static DEVICE_ATTR_RO(data);
++static DEVICE_ATTR_RW(enable);
++static DEVICE_ATTR_RW(delay);
++static DEVICE_ATTR_RO(vendor);
++
++static struct attribute *m1120_attrs[] = {
++	&dev_attr_data.attr,
++	&dev_attr_enable.attr,
++	&dev_attr_delay.attr,
++	&dev_attr_vendor.attr,
++	NULL,
++};
++ATTRIBUTE_GROUPS(m1120);
++
++static int m1120_input_init(struct m1120_data *d)
++{
++	struct input_dev *input;
++	const char *name;
++	int ret;
++
++	name = (d->pos == M1120_POS_UP) ? "m1120_up" :
++	       (d->pos == M1120_POS_DOWN) ? "m1120_down" : "m1120_middle";
++
++	input = devm_input_allocate_device(d->dev);
++	if (!input)
++		return -ENOMEM;
++
++	input->name = name;
++	input->phys = "m1120/input0";
++	input->id.bustype = BUS_I2C;
++	input->dev.parent = d->dev;
++
++	__set_bit(EV_ABS, input->evbit);
++	input_set_abs_params(input, ABS_X, -32768, 32767, 0, 0);
++
++	ret = input_register_device(input);
++	if (ret) {
++		dev_err(d->dev, "%s: m1120_input_dev_init was failed(%d)\n", __func__, ret);
++		return ret;
++	}
++	d->input = input;
++
++	dev_info(d->dev, "%s: %s was initialized\n", __func__, name);
++	return 0;
++}
++
++static int m1120_parse_dt(struct m1120_data *d)
++{
++	struct device_node *np = d->dev->of_node;
++	u32 v;
++
++	/*
++	 * [RE] the vendor probe parsed exactly these properties:
++	 *   magnachip,init-interval   u32  -> data->init_interval (0 becomes 1)
++	 *   magnachip,use-interrupt   bool -> data->use_interrupt
++	 *   magnachip,gpio-int        gpio -> data->gpio_int
++	 *   magnachip,use-hrtimer     bool -> data->use_hrtimer
++	 * The factory DT only sets init-interval = <1>, i.e. interrupt and
++	 * hrtimer mode are off and the sensor is polled.
++	 *
++	 * [RE] the vendor queued its work with a delay of 20, so one interval
++	 * unit is taken as 20 ms; the factory value of 1 therefore polls at
++	 * 20 ms, which is also the vendor's default when the property is
++	 * missing (it forces the value to 1).
++	 */
++	d->init_interval = 1;
++	d->delay_ms = 20;
++	d->ten_bit = true;
++
++	if (np && !of_property_read_u32(np, "magnachip,init-interval", &v) && v)
++		d->init_interval = v;
++	d->delay_ms = d->init_interval * 20;
++
++	/* parsed for completeness; interrupt and hrtimer modes are not wired up */
++	d->use_interrupt = np && of_property_read_bool(np, "magnachip,use-interrupt");
++	d->use_hrtimer = np && of_property_read_bool(np, "magnachip,use-hrtimer");
++	if (d->use_interrupt || d->use_hrtimer)
++		dev_info(d->dev,
++			 "%s: interrupt/hrtimer mode requested (interrupt %d, hrtimer %d), falling back to polling\n",
++			 __func__, d->use_interrupt, d->use_hrtimer);
++
++	d->reset_gpio = np ? of_get_named_gpio(np, "magnachip,gpio-int", 0) : -ENOENT;
++	if (gpio_is_valid(d->reset_gpio)) {
++		/* the vendor used this gpio as its interrupt line */
++		dev_info(d->dev, "%s: magnachip,gpio-int = %d (polled, gpio left as is)\n",
++			 __func__, d->reset_gpio);
++		d->reset_gpio = -ENOENT;
++	}
++	return 0;
++}
++
++static const struct of_device_id m1120_of_match[] = {
++	{ .compatible = "magnachip,mxm1120,up",     .data = (void *)M1120_POS_UP },
++	{ .compatible = "magnachip,mxm1120,down",   .data = (void *)M1120_POS_DOWN },
++	{ .compatible = "magnachip,mxm1120,middle", .data = (void *)M1120_POS_MIDDLE },
++	{ }
++};
++MODULE_DEVICE_TABLE(of, m1120_of_match);
++
++static const struct i2c_device_id m1120_id[] = {
++	{ "mxm1120_up", M1120_POS_UP },
++	{ "mxm1120_down", M1120_POS_DOWN },
++	{ }
++};
++MODULE_DEVICE_TABLE(i2c, m1120_id);
++
++static int m1120_i2c_drv_probe(struct i2c_client *client,
++			       const struct i2c_device_id *id)
++{
++	struct m1120_data *d;
++	const struct of_device_id *match;
++	int ret;
++
++	d = devm_kzalloc(&client->dev, sizeof(*d), GFP_KERNEL);
++	if (!d)
++		return -ENOMEM;
++
++	d->client = client;
++	d->dev = &client->dev;
++	mutex_init(&d->lock);
++	INIT_DELAYED_WORK(&d->work, m1120_work);
++	i2c_set_clientdata(client, d);
++	dev_set_drvdata(&client->dev, d);
++	strlcpy(d->line, "m1120: no data yet\n", sizeof(d->line));
++
++	match = i2c_of_match_device(m1120_of_match, client);
++	d->pos = match ? (enum m1120_pos)(uintptr_t)match->data : M1120_POS_UP;
++
++	if (!i2c_check_functionality(client->adapter,
++				     I2C_FUNC_SMBUS_I2C_BLOCK | I2C_FUNC_I2C)) {
++		dev_err(d->dev, "%s: i2c_check_functionality was failed\n", __func__);
++		return -EOPNOTSUPP;
++	}
++
++	/* optional supplies: the vendor probe requested two regulators */
++	d->vdd = devm_regulator_get_optional(d->dev, "vdd");
++	if (IS_ERR(d->vdd))
++		d->vdd = NULL;
++	d->vddio = devm_regulator_get_optional(d->dev, "vddio");
++	if (IS_ERR(d->vddio))
++		d->vddio = NULL;
++	if (d->vdd)
++		regulator_enable(d->vdd);
++	if (d->vddio)
++		regulator_enable(d->vddio);
++
++	m1120_parse_dt(d);
++
++	ret = m1120_init_device(d);
++	if (ret) {
++		dev_err(d->dev, "%s: m1120_init_device was failed(%d)\n", __func__, ret);
++		goto err_regs;
++	}
++
++	ret = m1120_input_init(d);
++	if (ret)
++		goto err_regs;
++
++	ret = devm_device_add_groups(d->dev, m1120_groups);
++	if (ret) {
++		dev_err(d->dev, "%s: sysfs_create_group was failed(%d)\n", __func__, ret);
++		goto err_regs;
++	}
++
++	d->enabled = true;
++	schedule_delayed_work(&d->work, msecs_to_jiffies(d->delay_ms));
++	dev_info(d->dev, "%s: %s-%s was found\n", __func__,
++		 d->pos == M1120_POS_UP ? "up" : (d->pos == M1120_POS_DOWN ? "down" : "middle"),
++		 M1120_DRV_NAME);
++	return 0;
++
++err_regs:
++	if (d->vddio)
++		regulator_disable(d->vddio);
++	if (d->vdd)
++		regulator_disable(d->vdd);
++	return ret;
++}
++
++static int m1120_i2c_drv_remove(struct i2c_client *client)
++{
++	struct m1120_data *d = i2c_get_clientdata(client);
++
++	if (!d)
++		return 0;
++	d->enabled = false;
++	cancel_delayed_work_sync(&d->work);
++	if (d->vddio)
++		regulator_disable(d->vddio);
++	if (d->vdd)
++		regulator_disable(d->vdd);
++	return 0;
++}
++
++static int m1120_suspend(struct device *dev)
++{
++	struct m1120_data *d = dev_get_drvdata(dev);
++
++	if (!d)
++		return 0;
++	cancel_delayed_work_sync(&d->work);
++	m1120_set_operation_mode(d, false);
++	return 0;
++}
++
++static int m1120_resume(struct device *dev)
++{
++	struct m1120_data *d = dev_get_drvdata(dev);
++
++	if (!d)
++		return 0;
++	if (d->enabled) {
++		m1120_set_operation_mode(d, true);
++		schedule_delayed_work(&d->work, msecs_to_jiffies(d->delay_ms));
++	}
++	return 0;
++}
++
++static const struct dev_pm_ops m1120_pm_ops = {
++	SET_SYSTEM_SLEEP_PM_OPS(m1120_suspend, m1120_resume)
++};
++
++static struct i2c_driver m1120_i2c_driver = {
++	.driver = {
++		.name		= M1120_DRV_NAME,
++		.owner		= THIS_MODULE,
++		.pm		= &m1120_pm_ops,
++		.of_match_table	= of_match_ptr(m1120_of_match),
++	},
++	.probe		= m1120_i2c_drv_probe,
++	.remove		= m1120_i2c_drv_remove,
++	.id_table	= m1120_id,
++};
++module_i2c_driver(m1120_i2c_driver);
++
++MODULE_AUTHOR("EEBBK S6 kernel reconstruction");
++MODULE_DESCRIPTION("Magnachip MXM1120 hall sensor (reconstructed from the factory binary)");
++MODULE_LICENSE("GPL v2");
diff --git a/patch12/0003-misc-Add-the-BBK-elevator-camera-motor-controller.patch b/patch12/0003-misc-Add-the-BBK-elevator-camera-motor-controller.patch
new file mode 100644
index 000000000..af0aefef6
--- /dev/null
+++ b/patch12/0003-misc-Add-the-BBK-elevator-camera-motor-controller.patch
@@ -0,0 +1,1016 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Zhiyu722 <Zhiyu722@users.noreply.github.com>
+Date: Sat, 12 Sep 2026 22:55:13 +0800
+Subject: [PATCH] misc: Add the BBK elevator camera motor controller
+
+The front camera of the EEBBK S6 sits on a motorised elevator that is pushed out
+when the camera application starts.  The controller driver is called vib_pwm in
+the factory kernel (CONFIG_VIB_PWM=y) and its source is not part of this tree,
+so the device tree binding, the sysfs interface and the motor timing were
+recovered from the factory boot image and from the factory device tree.
+
+Hardware, from the node soc:bbk_vib_pwm (compatible "bbk,vib_pwm_control"):
+
+  boost-gpio  gpio24  driver supply boost, high while moving
+  enable-gpio gpio23  driver enable, low while moving
+  sleep-gpio  gpio29  driver nSLEEP, high while moving
+  dir-gpio    gpio26  zero moves the elevator up, one moves it down
+  id-gpio     gpio25  elevator module id strap, read through a pull-up
+  clocks = <&gcc GCC_GP2_CLK>, clock-names = "gp2_clk"
+
+There is no pwm controller in the binding: the drive waveform is the general
+purpose clock gcc_gp2_clk, which the "vib_pwm_active" pinctrl state routes out on
+gpio21, so the chopper frequency is the clock rate.  GCC_GP2_CLK is clock id 36
+in qcom,gcc-sdmmagpie.h and gcc_gp2_clk_src is a fractional (mnd) rcg, so the
+32000 Hz the vendor programs is synthesizable even though the preset frequency
+table only lists 19.2, 25, 50, 100 and 200 MHz.
+
+One move, replicated from vib_pwm_set_camera_state:
+
+  clk_set_rate(gp2_clk, 32000)
+  bbk_hall_core_enable(0)
+  clk_prepare(gp2_clk)
+  dir = 0 for up, 1 for down
+  boost = 1; msleep(3); enable = 0; sleep = 1; msleep(3)
+  clk_enable(gp2_clk)
+  hrtimer_start(&timer, move_time, HRTIMER_MODE_REL_PINNED)
+  bbk_hall_core_enable(1)
+
+and the stop path is boost = 0, msleep(5), enable = 1, sleep = 0 and
+clk_disable_unprepare.  The move time is six tenths of the value in the "time"
+field, except that values above 65536 run in fixed 50 ms ticks instead; the
+vendor stores the scaled value back, which is also done here.
+
+The whole userspace interface the factory exposed is provided with the same
+names and modes: vib_pwm_id (0444, the id strap), vib_pwm_frequency,
+vib_pwm_count, vib_pwm_enable, vib_pwm_dir, vib_pwm_time, vib_pwm_camera_state,
+vib_pwm_state_init, vib_pwm_abort_notify, vib_pwm_holder_mode,
+vib_pwm_elevator_mode, vib_pwm_elevator_row_shift, vib_pwm_cali,
+vib_pwm_up_down_count and vib_pwm_clear_cali_data.  Writing 0, 1 or 2 to
+vib_pwm_camera_state retracts the elevator, raises it or raises and tilts it,
+4 and 5 mean that a move is in progress and are reported while it runs, and a
+calibration in progress blocks new moves, exactly as in the vendor driver.
+vib_pwm_dir and vib_pwm_time keep the vendor's quirks ("1" as the first
+character sets the direction, 1300 means "use the default move time").
+
+The hall framework is a separate driver: bbk_hall_core_enable() and
+bbk_hall_get_status() are declared weak here, so this driver works on its own
+and picks up the hall support as soon as bbk_hall_core is built in.  The end of
+a move is currently decided by the timeout, with the hall end position as an
+early stop condition; the vendor's exact calibration constants live in its
+module parameters and in the calibration files under
+/mnt/vendor/persist/sensors, and every duration can be overridden by writing
+vib_pwm_time.
+
+Signed-off-by: Zhiyu722 <Zhiyu722@users.noreply.github.com>
+---
+ drivers/misc/Kconfig       |  10 +
+ drivers/misc/Makefile      |   1 +
+ drivers/misc/bbk_vib_pwm.c | 911 +++++++++++++++++++++++++++++++++++++
+ 3 files changed, 922 insertions(+)
+ create mode 100755 drivers/misc/bbk_vib_pwm.c
+
+diff --git a/drivers/misc/Kconfig b/drivers/misc/Kconfig
+index 2d4c9718e..de3a0a18f 100644
+--- a/drivers/misc/Kconfig
++++ b/drivers/misc/Kconfig
+@@ -628,3 +628,13 @@ config OKL4_LINK_SHBUF
+ 	      transport. This driver presents the link to Linux as a character device
+ 	      which can be written to or read from to access the shared memory. An ioctl
+ 	      on the device is used to send a virtual interrupt to the partner cell.
++config VIB_PWM
++	tristate "BBK elevator camera motor controller"
++	depends on OF && GPIOLIB
++	help
++	  Say Y here to support the BBK elevator motor that pushes the front camera
++	  of the EEBBK S6 out of the body (dt: bbk,vib_pwm_control).  The driver is
++	  reconstructed from the vendor kernel binary because the vendor sources are
++	  not part of this tree.
++
++
+diff --git a/drivers/misc/Makefile b/drivers/misc/Makefile
+index 553ddb0d5..09eaa0c89 100644
+--- a/drivers/misc/Makefile
++++ b/drivers/misc/Makefile
+@@ -91,3 +91,4 @@ $(obj)/lkdtm_rodata_objcopy.o: $(obj)/lkdtm_rodata.o FORCE
+ obj-$(CONFIG_OKL4_USER_VIPC)    += okl4-vipc.o
+ obj-$(CONFIG_OKL4_GUEST)        += okl4-panic.o
+ obj-$(CONFIG_OKL4_LINK_SHBUF)    += okl4-link-shbuf.o
++obj-$(CONFIG_VIB_PWM)		+= bbk_vib_pwm.o
+diff --git a/drivers/misc/bbk_vib_pwm.c b/drivers/misc/bbk_vib_pwm.c
+new file mode 100755
+index 000000000..89c155862
+--- /dev/null
++++ b/drivers/misc/bbk_vib_pwm.c
+@@ -0,0 +1,911 @@
++/*
++ * BBK elevator camera motor controller for the EEBBK S6 (P20H130).
++ *
++ * The front camera of this device sits on a motorised elevator: it is pushed
++ * out of the body when the camera application starts and retracted again
++ * afterwards.  The controller driver is called vib_pwm in the factory kernel
++ * and its source is not part of this tree, so the device tree bindings, the
++ * sysfs interface and the motor timing were recovered from the factory boot
++ * image and its device tree.
++ *
++ * Hardware (from the factory device tree, node soc:bbk_vib_pwm)
++ *   compatible = "bbk,vib_pwm_control"
++ *   boost-gpio  GPIO24   driver supply boost converter, high while moving
++ *   enable-gpio GPIO23   driver enable, pulled low while moving
++ *   sleep-gpio  GPIO29   driver nSLEEP, high while moving
++ *   dir-gpio    GPIO26   0 moves the elevator up, 1 moves it down
++ *   id-gpio     GPIO25   elevator module id strap, read through a pull-up
++ *   clocks = <&gcc GCC_GP2_CLK>, clock-names = "gp2_clk"
++ *
++ * There is no pwm controller: the drive waveform is the general purpose clock
++ * gcc_gp2_clk, which the "vib_pwm_active" pinctrl state routes out on gpio21,
++ * so the chopper frequency is simply the clock rate.  gcc_gp2_clk_src is a
++ * fractional (mnd) rcg, so a 32 kHz rate is synthesizable even though the
++ * preset table only lists 19.2, 25, 50, 100 and 200 MHz.
++ *
++ * Recovered from the factory binary (symbols are still in its kallsyms)
++ *   vib_pwm_probe, vib_pwm_set_camera, vib_pwm_set_camera_state,
++ *   vib_pwm_state_move_sate, vib_pwm_camera_state_show/store, the fifteen
++ *   dev_attr_vib_pwm_* attributes, get_camera_state, cancel_vib_hrtimer,
++ *   set_vib_all_time, set_vib_up_down_count, is_top_or_bottom,
++ *   computer_distance, vib_is_in_cali, vib_is_move.
++ *
++ * Private data layout of the vendor driver, as far as it could be recovered
++ * (offset : meaning), kept here because the sysfs handlers and the state
++ * machine both address it by offset:
++ *   +16  boost gpio        +20  enable gpio      +24  sleep gpio
++ *   +28  dir gpio          +32  id gpio          +72  struct clk *gp2_clk
++ *   +152 struct wakeup_source (the driver calls __pm_stay_awake on it)
++ *   +344 ktime_t of the current move (nanoseconds, for the hrtimer)
++ *   +352 unsigned int time, the move duration in milliseconds
++ *   +356 int tick, 50 when the move is run in fixed ticks
++ *   +360 u8 use_tick, set when time > 65536
++ *   +400 unsigned long freq, the clock rate handed to clk_set_rate
++ *   +412 int motor, 1 moves up, 2 moves down, anything else stops
++ *   +416 int camera_state, the value vib_pwm_camera_state reports
++ *   +472 unsigned int count, incremented once per started move
++ *   +540 int is_in_cali
++ *
++ * The vendor sequence for one move, replicated here instruction for
++ * instruction, is
++ *   clk_set_rate(gp2_clk, freq)      (the vendor programs 32000 for every move)
++ *   bbk_hall_core_enable(0)
++ *   clk_prepare(gp2_clk)
++ *   gpio dir = 0 for up, 1 for down
++ *   gpio boost = 1
++ *   msleep(3)
++ *   gpio enable = 0
++ *   gpio sleep = 1
++ *   msleep(3)
++ *   clk_enable(gp2_clk)
++ *   hrtimer_start(&timer, move_time, HRTIMER_MODE_REL_PINNED)
++ *   bbk_hall_core_enable(1)
++ * and to stop it
++ *   gpio boost = 0
++ *   msleep(5)
++ *   gpio enable = 1
++ *   gpio sleep = 0
++ *   clk_disable_unprepare(gp2_clk)
++ *
++ * SPDX-License-Identifier: GPL-2.0
++ */
++#include <linux/module.h>
++#include <linux/platform_device.h>
++#include <linux/of.h>
++#include <linux/of_gpio.h>
++#include <linux/gpio.h>
++#include <linux/clk.h>
++#include <linux/pinctrl/consumer.h>
++#include <linux/hrtimer.h>
++#include <linux/ktime.h>
++#include <linux/delay.h>
++#include <linux/slab.h>
++#include <linux/mutex.h>
++#include <linux/sysfs.h>
++#include <linux/pm_wakeup.h>
++#include <linux/uaccess.h>
++
++#define VIB_PWM_DRV_NAME	"bbk_vib_pwm"
++
++/* camera_state values, as the vendor reports them */
++#define CAM_STATE_DOWN		0	/* retracted */
++#define CAM_STATE_UP		1	/* raised */
++#define CAM_STATE_UP_TILT	2	/* raised and tilted */
++#define CAM_STATE_BUSY_UP	4	/* moving up */
++#define CAM_STATE_BUSY_DOWN	5	/* moving down */
++
++/* the vendor's per-move chopper frequency and its tick period */
++#define VIB_PWM_DEFAULT_FREQ	32000
++#define VIB_PWM_TICK_MS		50
++#define VIB_PWM_TICK_LIMIT	65536
++#define VIB_PWM_TIME_MAGIC	1300	/* writing this uses the parameter below */
++#define VIB_PWM_MOVE_RATIO_NUM	6	/* move_time = 6 * time / 10 */
++#define VIB_PWM_MOVE_RATIO_DEN	10
++
++/*
++ * Move durations used when userspace has not set one through vib_pwm_time.
++ * [RE] the vendor derives the raise duration as "696 + parameter / 1000" so
++ * 696 ms is its base value, and the probe leaves the same 696 in the field.
++ * The extra stages are calibration values that live in the vendor's module
++ * parameters, they can all be overridden by writing vib_pwm_time.
++ */
++#define VIB_PWM_BASE_MS		696	/* retracted to fully raised */
++#define VIB_PWM_TILT_MS		1160	/* retracted to raised and tilted */
++#define VIB_PWM_TILT_ONLY_MS	400	/* raised to raised and tilted */
++#define VIB_PWM_DOWN_MS		1160	/* retract from any raised position */
++
++/* weak hooks implemented by bbk_hall_core when it is built in */
++/*
++ * The hall framework is a separate driver.  Declaring these weak keeps this
++ * driver linkable and working on its own, and lets bbk_hall_core take over as
++ * soon as it is built in.
++ */
++int __weak bbk_hall_core_enable(int enable)
++{
++	return 0;
++}
++
++int __weak bbk_hall_get_status(void)
++{
++	return 0;
++}
++
++struct vib_pwm {
++	struct device		*dev;
++	struct mutex		lock;
++	struct clk		*gp2_clk;
++	struct pinctrl		*pinctrl;
++	struct pinctrl_state	*pins_active;
++	struct pinctrl_state	*pins_suspend;
++	struct pinctrl_state	*pins_idconfig;
++	int			boost_gpio;
++	int			enable_gpio;
++	int			sleep_gpio;
++	int			dir_gpio;
++	int			id_gpio;
++	struct wakeup_source	wakeup;
++	wait_queue_head_t	wait;
++	struct hrtimer		timer;
++	bool			moving;
++	unsigned int		time_ms;	/* +352 */
++	int			tick_ms;	/* +356 */
++	bool			use_tick;	/* +360 */
++	unsigned long		freq;		/* +400 */
++	int			motor;		/* +412 */
++	int			camera_state;	/* +416 */
++	unsigned int		count;		/* +472 */
++	int			is_in_cali;	/* +540 */
++	bool			cam_up;
++	/* user visible tuning values */
++	int			id;
++	int			state_init;
++	int			holder_mode;
++	int			elevator_mode;
++	int			elevator_row_shift;
++	int			up_down_count;
++	int			abort_notify;
++	int			cali;
++	int			pending_time;
++};
++
++static struct vib_pwm *vib_pwm_dev;
++
++/* ----------------------------------------------------------- motor core -- */
++
++static void vib_pwm_gpio_set(int gpio, int value)
++{
++	if (gpio_is_valid(gpio))
++		gpiod_direction_output_raw(gpio_to_desc(gpio), value);
++}
++
++static void vib_pwm_gpio_input(int gpio)
++{
++	if (gpio_is_valid(gpio))
++		gpiod_direction_input(gpio_to_desc(gpio));
++}
++
++/*
++ * [RE] vib_pwm_set_camera_state, the second half: program the clock, bring the
++ * driver up in the order the vendor used and arm the move timer.
++ */
++static int vib_pwm_motor_start(struct vib_pwm *d, int dir)
++{
++	ktime_t when;
++	int ret;
++
++	/* the vendor programs 32000 Hz for every single move */
++	d->freq = VIB_PWM_DEFAULT_FREQ;
++
++	ret = clk_set_rate(d->gp2_clk, d->freq);
++	if (ret < 0) {
++		dev_err(d->dev, "%s: clk_set_rate(%lu) failed (%d)\n",
++			__func__, d->freq, ret);
++		return ret;
++	}
++
++	bbk_hall_core_enable(0);
++	clk_prepare(d->gp2_clk);
++
++	/* direction first: 0 raises the elevator, 1 lowers it */
++	vib_pwm_gpio_set(d->dir_gpio, dir == 1 ? 0 : 1);
++
++	vib_pwm_gpio_set(d->boost_gpio, 1);
++	msleep(3);
++	vib_pwm_gpio_set(d->enable_gpio, 0);
++	vib_pwm_gpio_set(d->sleep_gpio, 1);
++	msleep(3);
++
++	clk_enable(d->gp2_clk);
++
++	/* move duration: the vendor ticks at 50 ms for very long values */
++	if (d->time_ms > VIB_PWM_TICK_LIMIT) {
++		d->use_tick = true;
++		d->tick_ms = VIB_PWM_TICK_MS;
++		when = ktime_set(0, (u64)VIB_PWM_TICK_MS * NSEC_PER_MSEC);
++	} else {
++		unsigned int ms = d->time_ms * VIB_PWM_MOVE_RATIO_NUM /
++				  VIB_PWM_MOVE_RATIO_DEN;
++		if (!ms)
++			ms = VIB_PWM_TICK_MS;
++		d->time_ms = ms;	/* [RE] the vendor stores the scaled value back */
++		when = ktime_set(0, (u64)ms * NSEC_PER_MSEC);
++	}
++
++	d->count++;
++	d->moving = true;
++	hrtimer_start(&d->timer, when, HRTIMER_MODE_REL_PINNED);
++
++	bbk_hall_core_enable(1);
++	dev_info(d->dev, "%s: moving %s, %u ms, %lu Hz\n", __func__,
++		 dir == 1 ? "up" : "down", d->time_ms, d->freq);
++	return 0;
++}
++
++/* [RE] the stop path of vib_pwm_set_camera_state */
++static void vib_pwm_motor_stop(struct vib_pwm *d)
++{
++	if (d->moving) {
++		hrtimer_cancel(&d->timer);
++		d->moving = false;
++	}
++
++	vib_pwm_gpio_set(d->boost_gpio, 0);
++	msleep(5);
++	vib_pwm_gpio_set(d->enable_gpio, 1);
++	vib_pwm_gpio_set(d->sleep_gpio, 0);
++	clk_disable_unprepare(d->gp2_clk);
++}
++
++/*
++ * End of a move.  The vendor's callback (vib_pwm_state_move_sate) either stops
++ * the motor or, when the move runs in fixed ticks, keeps it running until the
++ * hall sensors report an end position.  We always use the timeout as the
++ * stop condition and additionally stop early when bbk_hall_core reports that
++ * the elevator reached an end position.
++ */
++static enum hrtimer_restart vib_pwm_timer_func(struct hrtimer *timer)
++{
++	struct vib_pwm *d = container_of(timer, struct vib_pwm, timer);
++	int end = bbk_hall_get_status();
++
++	if (d->use_tick && !end) {
++		/* keep chopping in fixed ticks until the hall reports an end */
++		hrtimer_forward_now(timer, ktime_set(0, (u64)d->tick_ms * NSEC_PER_MSEC));
++		return HRTIMER_RESTART;
++	}
++
++	/* we are inside the callback, so do not try to cancel ourselves */
++	d->moving = false;
++	vib_pwm_motor_stop(d);
++
++	mutex_lock(&d->lock);
++	d->camera_state = (d->motor == 1) ? (d->cam_up ? CAM_STATE_UP : CAM_STATE_UP_TILT)
++					  : CAM_STATE_DOWN;
++	d->motor = 0;
++	mutex_unlock(&d->lock);
++
++	wake_up_interruptible(&d->wait);
++	dev_info(d->dev, "%s: move finished, camera_state = %d\n",
++		 __func__, d->camera_state);
++	return HRTIMER_NORESTART;
++}
++
++/*
++ * [RE] vib_pwm_set_camera: the transition table.  want is the value userspace
++ * writes to vib_pwm_camera_state.
++ */
++int vib_pwm_set_camera(int want)
++{
++	struct vib_pwm *d = vib_pwm_dev;
++	int cur, ret = 0;
++
++	if (!d)
++		return -ENODEV;
++
++	mutex_lock(&d->lock);
++	cur = d->camera_state;
++
++	/* [RE] states 4 and 5 are busy, and a calibration blocks a move */
++	if ((cur & ~1) == CAM_STATE_BUSY_UP || d->is_in_cali) {
++		dev_info(d->dev,
++			 "%s: want %d, current %d, is_in_cali %d: busy, ignored\n",
++			 __func__, want, cur, d->is_in_cali);
++		goto out;
++	}
++
++	if (cur == want) {
++		dev_info(d->dev, "%s: already in state %d\n", __func__, want);
++		goto out;
++	}
++
++	switch (want) {
++	case CAM_STATE_UP:
++		/*
++		 * Raise out of the body.  [RE] the vendor computes
++		 * "696 + parameter / 1000" for this transition, so 696 ms is the
++		 * base and the calibration parameter only trims it.
++		 */
++		d->cam_up = true;
++		d->motor = 1;
++		d->camera_state = CAM_STATE_BUSY_UP;
++		d->time_ms = d->pending_time ? d->pending_time : VIB_PWM_BASE_MS;
++		break;
++	case CAM_STATE_UP_TILT:
++		/* raise and then tilt: the second stage keeps going up */
++		d->cam_up = false;
++		d->motor = 1;
++		d->camera_state = CAM_STATE_BUSY_UP;
++		d->time_ms = d->pending_time ? d->pending_time : VIB_PWM_TILT_MS;
++		break;
++	case CAM_STATE_DOWN:
++		/* retract */
++		d->cam_up = false;
++		d->motor = 2;
++		d->camera_state = CAM_STATE_BUSY_DOWN;
++		d->time_ms = d->pending_time ? d->pending_time : VIB_PWM_DOWN_MS;
++		break;
++	default:
++		dev_info(d->dev, "%s: unrecognised camera state %d\n", __func__, want);
++		goto out;
++	}
++
++	/* when the elevator is already up, only the tilt remainder is needed */
++	if (want == CAM_STATE_UP_TILT && cur == CAM_STATE_UP)
++		d->time_ms = d->pending_time ? d->pending_time : VIB_PWM_TILT_ONLY_MS;
++
++	if (d->state_init)
++		__pm_stay_awake(&d->wakeup);
++
++	ret = vib_pwm_motor_start(d, d->motor);
++	if (ret) {
++		d->camera_state = cur;
++		d->motor = 0;
++		if (d->state_init)
++			__pm_relax(&d->wakeup);
++		goto out;
++	}
++
++	d->count++;
++	wake_up_interruptible(&d->wait);
++	dev_info(d->dev, "%s: want %d, current %d -> starting motor %d for %u ms\n",
++		 __func__, want, cur, d->motor, d->time_ms);
++out:
++	mutex_unlock(&d->lock);
++	return ret;
++}
++EXPORT_SYMBOL_GPL(vib_pwm_set_camera);
