From 9eb72677a5cf83556df2e3df43b5f1fa656ac276 Mon Sep 17 00:00:00 2001
From: Zhiyu722 <Zhiyu722@users.noreply.github.com>
Date: Sat, 12 Sep 2026 21:50:02 +0800
Subject: [PATCH 11/73] arm64: configs: Enable the IST8801 hall switch

CONFIG_INPUT_IST8801=y, matching the factory kernel configuration.

Signed-off-by: Zhiyu722 <Zhiyu722@users.noreply.github.com>
---
 arch/arm64/configs/h130_factory.config | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/configs/h130_factory.config b/arch/arm64/configs/h130_factory.config
index db98a2aff..1de0d58a3 100755
--- a/arch/arm64/configs/h130_factory.config
+++ b/arch/arm64/configs/h130_factory.config
@@ -2215,6 +2215,7 @@ CONFIG_INPUT_MXM1120_UP=y
 # CONFIG_INPUT_MXM1120_MIDDLE is not set
 CONFIG_INPUT_MXM1120_DOWN=y
 CONFIG_INPUT_IST8801=y
+CONFIG_INPUT_IST8801=y
 
 #
 # Hardware I/O ports
