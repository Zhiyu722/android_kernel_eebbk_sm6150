-#else
+#elif defined(CONFIG_DRM) || defined(CONFIG_MSM_DRM)
     if (msm_drm_unregister_client(&ts_data->fb_notif))
-        FTS_ERROR("[DRM]Error occurred while unregistering fb_notifier.\n");
-#endif
