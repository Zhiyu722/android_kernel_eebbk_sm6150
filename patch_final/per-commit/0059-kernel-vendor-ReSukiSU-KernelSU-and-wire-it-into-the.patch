+#include "linux/stop_machine.h"
+#include "asm/cacheflush.h"
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 8, 0)
+#include <asm-generic/fixmap.h>
+#include <asm/fixmap.h>
