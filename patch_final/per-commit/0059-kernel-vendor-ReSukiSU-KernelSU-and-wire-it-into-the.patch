+        goto out;
+    length = security_context_to_sid_with_policy(backup_sepolicy, buf, size, &sid, SECSID_NULL, GFP_KERNEL);
+    if (length)
+        goto out;
+
+    length = security_sid_to_context_with_policy(backup_sepolicy, sid, &canon, &len);
