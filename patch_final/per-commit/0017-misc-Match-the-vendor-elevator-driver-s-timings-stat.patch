+/* [RE] vib_update_key: the vendor injects a press and a release per event */
+void vib_update_key(int key)
+{
+	struct vib_pwm *d = vib_pwm_dev;
+
+	if (!d || !d->input)
+		return;
+	if (key < VIB_KEY_FIRST || key > VIB_KEY_LAST)
+		return;
