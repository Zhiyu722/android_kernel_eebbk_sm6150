diff --git a/patch12/0007-misc-Accept-the-mhall-calibration-from-the-hall-fram.patch b/patch12/0007-misc-Accept-the-mhall-calibration-from-the-hall-fram.patch
deleted file mode 100644
index e669fa4bc..000000000
--- a/patch12/0007-misc-Accept-the-mhall-calibration-from-the-hall-fram.patch
+++ /dev/null
@@ -1,86 +0,0 @@
-From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
-From: Zhiyu722 <Zhiyu722@users.noreply.github.com>
-Date: Sun, 13 Sep 2026 09:41:05 +0800
-Subject: [PATCH] misc: Accept the mhall calibration from the hall framework
-
-The hall framework persists a 48 byte calibration blob (cali_mhall_final) and
-hands it to the motor driver through init_hall_data_fake(), which the vendor
-exports from the motor driver and returns 1 for a valid blob.  Implement it:
-the blob's up and down dead zones, its holder target reading, its time
-correction and its add_time go into the module parameters, so they survive in
-/sys/module/gpio_pwm/parameters/ exactly like the vendor's mhall_fake_data_*
-globals, and a blob that is not marked valid is rejected with -1.
-
-Without it the framework's SET_MHALL_CALI ioctl could only fail.
-
-Signed-off-by: Zhiyu722 <Zhiyu722@users.noreply.github.com>
----
- drivers/misc/gpio_pwm.c | 55 +++++++++++++++++++++++++++++++++++++++++
- 1 file changed, 55 insertions(+)
-
-diff --git a/drivers/misc/gpio_pwm.c b/drivers/misc/gpio_pwm.c
-index 69b1ca846..c28351468 100755
---- a/drivers/misc/gpio_pwm.c
-+++ b/drivers/misc/gpio_pwm.c
-@@ -1274,6 +1274,61 @@ static struct platform_driver vib_pwm_driver = {
- 		.pm		= &vib_pwm_pm_ops,
- 	},
- };
-+
-+/* ------------------------------------------------- mhall calibration ----- */
-+
-+/*
-+ * [RE] the 48 byte blob the framework persists as cali_mhall_final.  Its layout
-+ * is fixed by the file userspace writes, so it is repeated here rather than
-+ * shared through a header:
-+ *   +0x00 s16 hall_up   +0x02 s16 hall_down   +0x04 int valid (must be 1)
-+ *   +0x08 s16 hall_up_1 +0x10 s16 hall_up_2   +0x18 s16 hall_up_3
-+ *   +0x20 s16 hall_up_4 +0x28 int f2          +0x2c int add_time
-+ */
-+struct mhall_cali_blob {
-+	s16	hall_up;
-+	s16	hall_down;
-+	int	valid;
-+	s16	hall_up_1;
-+	u8	pad0[6];
-+	s16	hall_up_2;
-+	u8	pad1[6];
-+	s16	hall_up_3;
-+	u8	pad2[6];
-+	s16	hall_up_4;
-+	u8	pad3[6];
-+	int	f2;
-+	int	add_time;
-+};
-+
-+/*
-+ * [RE] init_hall_data_fake: the hall framework calls this after it accepted a
-+ * calibration blob, and the value comes back as one of our module parameters so
-+ * that it survives in /sys/module/gpio_pwm/parameters/.  The vendor returns 1 on
-+ * success and -1 when the blob is not marked valid.
-+ */
-+int init_hall_data_fake(const void *p)
-+{
-+	const struct mhall_cali_blob *b = p;
-+
-+	if (!b || b->valid != 1) {
-+		pr_err("zyhc set mhall cali data failed\n");
-+		return -1;
-+	}
-+
-+	mhall_control_up = b->hall_up;
-+	mhall_control_down = b->hall_down;
-+	mhall_control3 = b->hall_up_1;
-+	mhall_control2 = b->f2;
-+	mhall_control6 = b->add_time;
-+
-+	pr_info("zyhc data_up:%d,data_down:%d,fake_data2:%d,fake_data3:%d,add_time:%d\n",
-+		mhall_control_up, mhall_control_down, mhall_control2,
-+		mhall_control3, mhall_control6);
-+	return 1;
-+}
-+EXPORT_SYMBOL_GPL(init_hall_data_fake);
-+
- module_platform_driver(vib_pwm_driver);
- 
- MODULE_AUTHOR("EEBBK S6 kernel reconstruction");
diff --git a/s6patch声音/0001-kernel-module-accept-vendor-crc.patch b/s6patch声音/0001-kernel-module-accept-vendor-crc.patch
deleted file mode 100755
index 5e211e337..000000000
--- a/s6patch声音/0001-kernel-module-accept-vendor-crc.patch
+++ /dev/null
@@ -1,38 +0,0 @@
-[PATCH 1/3] module: accept vendor DLKM modules (survives CONFIG_MODVERSIONS)
-
-CONFIG_MODVERSIONS is part of the vermagic string, so it cannot be disabled
-without breaking the match with the vendor modules
-("4.14.190-perf SMP preempt mod_unload modversions aarch64").  Accept symbol
-CRC mismatches instead (same effect as modprobe --force); keeps the vermagic
-identical.
-
-On hardware this took lsmod from 1 to 35 modules and stopped the vendor audio
-HAL from crashing in get_sndcard_id().
---- a/kernel/module.c
-+++ b/kernel/module.c
-@@ -1322,9 +1322,23 @@
- 	return 1;
- 
- bad_version:
--	pr_warn("%s: disagrees about version of symbol %s\n",
-+	/*
-+	 * EEBBK S6 (P20H130): the vendor DLKM modules in /vendor/lib/modules
-+	 * are built from the complete vendor source tree, together with the
-+	 * kernel that ships with the device.  A kernel built from this
-+	 * (incomplete) source tree computes different symbol CRCs, so every
-+	 * vendor module used to be rejected here - which removed the sound
-+	 * card, made the vendor audio HAL crash and left the device stuck on
-+	 * the boot animation.
-+	 *
-+	 * CONFIG_MODVERSIONS cannot simply be turned off because "modversions"
-+	 * is part of the vermagic string the vendor modules carry.  Accept the
-+	 * mismatch instead (same effect as "modprobe --force") and keep the
-+	 * warning so the mismatch stays visible.
-+	 */
-+	pr_warn("%s: disagrees about version of symbol %s (accepted for vendor modules)\n",
- 	       info->name, symname);
--	return 0;
-+	return 1;
- }
- 
- static inline int check_modstruct_version(const struct load_info *info,
