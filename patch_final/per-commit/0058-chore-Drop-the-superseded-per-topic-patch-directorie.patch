-+#### (5) `vib_pwm_dir` 0664
-+```c
-+/* show */ return sprintf(buf, "dir=%d\n", gpiod_get_raw_value(gpio_to_desc(h->dir_gpio)));
-+/* store */
-+if (buf && count) {
