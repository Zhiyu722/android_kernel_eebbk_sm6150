-+		d->motor = 1;
-+		d->camera_state = CAM_STATE_BUSY_UP;
-+		d->time_ms = d->pending_time ? d->pending_time : VIB_PWM_TILT_MS;
-+		break;
-+	case CAM_STATE_DOWN:
