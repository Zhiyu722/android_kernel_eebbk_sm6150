diff --git a/s6patch相机/build_eebbk_clang11.sh b/s6patch相机/build_eebbk_clang11.sh
deleted file mode 100755
index 57994d39a..000000000
--- a/s6patch相机/build_eebbk_clang11.sh
+++ /dev/null
@@ -1,95 +0,0 @@
-#!/bin/bash
-# ---------------------------------------------------------------------------
-# EEBBK S6 (P20H130 / sm6150 / sdmmagpiep) kernel build script
-#
-#   clang 11 + LLVM lld, Android 10/11 CAF msm-4.14 kernel
-#
-# Key points
-#   1. techpack/audio MUST be built into the kernel image (TECHPACK=y, which is
-#      also techpack/Kbuild's own default -- do NOT pass TECHPACK=n).
-#      This is what fixes "no sound":
-#        * the image then carries the whole QCOM audio stack (Q6/APR, bolero,
-#          wcd937x, wsa-macro, aw882xx smart-PA, the sm6150 machine driver);
-#        * and, above all, CONFIG_MSM_ADSP_LOADER=y, i.e. techpack/audio/dsp/
-#          adsp-loader.c, which binds the "qcom,adsp-loader" DT node and calls
-#          subsystem_get("adsp") to bring the ADSP up.  Without it the ADSP
-#          never boots, adsprpcd loops on "Transport endpoint is not
-#          connected", audioserver never publishes media.audio_policy and the
-#          device freezes on the boot animation.
-#      The vendor copy of that loader in /vendor/lib/modules cannot do the job
-#      here: those modules were built against a different kernel and are ABI
-#      incompatible with this tree.
-#   2. The link must use ld.lld: the aarch64 GNU ld shipped with modern
-#      distributions (2.38) mis-places the .bss.rtic section and fails with
-#      "relocation truncated to fit: R_AARCH64_ADR_PREL_PG_HI21".
-#
-# Usage:
-#   ./build_eebbk_clang11.sh                      # factory config + TECHPACK=y
-#   TECHPACK_MODE=n ./build_eebbk_clang11.sh      # old, sound-less build
-#   CONFIG=h130.config ./build_eebbk_clang11.sh   # build with the repo config
-# ---------------------------------------------------------------------------
-set -e
-
-TAG=${TAG:-eebbk}
-OUT=${OUT:-out}
-JOBS=${JOBS:-$(nproc)}
-TECHPACK_MODE=${TECHPACK_MODE:-y}
-CCBIN=${CCBIN:-clang-11}
-LDBIN=${LDBIN:-ld.lld}
-KCONFIG=${CONFIG:-h130_factory.config}
-
-cd "$(dirname "$0")"
-
-export ARCH=arm64
-export SUBARCH=arm64
-export CROSS_COMPILE=aarch64-linux-gnu-
-export CLANG_TRIPLE=aarch64-linux-gnu-
-export TARGET_PRODUCT=sm6150
-export KBUILD_BUILD_USER=${KBUILD_BUILD_USER:-cp}
-export KBUILD_BUILD_HOST=${KBUILD_BUILD_HOST:-ubuntu165}
-
-echo "== toolchain =="
-$CCBIN --version | head -1
-$LDBIN --version | head -1
-
-# techpack/Kbuild contains "TECHPACK?=y", so leaving this unset also builds the
-# audio stack in.  Only an explicit TECHPACK=n removes it (and with it the ADSP
-# loader -> no sound at all).
-echo "== configure ($KCONFIG, TECHPACK=$TECHPACK_MODE) =="
-rm -rf "$OUT"
-mkdir -p "$OUT"
-cp "arch/arm64/configs/$KCONFIG" "$OUT/.config"
-make -j"$JOBS" O="$OUT" CC="$CCBIN" LD="$LDBIN" TECHPACK="$TECHPACK_MODE" olddefconfig
-
-# The vendor DLKM modules in /vendor/lib/modules were signed with the vendor
-# module key and carry CRCs computed in the complete vendor tree.  A kernel
-# built here cannot match either, so relax just those two checks - the
-# vermagic string itself stays identical (that one must match!):
-#   * CONFIG_MODULE_SIG_FORCE=n   (keep CONFIG_MODULE_SIG / MODVERSIONS =y)
-#   * kernel/module.c check_version() accepts CRC mismatches (see bad_version)
-echo "== relax module signature force =="
-sed -i 's/^CONFIG_MODULE_SIG_FORCE=y/# CONFIG_MODULE_SIG_FORCE is not set/' "$OUT/.config"
-make -j"$JOBS" O="$OUT" CC="$CCBIN" LD="$LDBIN" TECHPACK="$TECHPACK_MODE" olddefconfig
-grep -E '^CONFIG_MODVERSIONS|^# CONFIG_MODULE_SIG_FORCE' "$OUT/.config"
-
-echo "== build Image.gz =="
-make -j"$JOBS" O="$OUT" CC="$CCBIN" LD="$LDBIN" TECHPACK="$TECHPACK_MODE" DTC=dtc Image.gz
-
-echo "== artifacts =="
-ls -la "$OUT/arch/arm64/boot/Image.gz" "$OUT/vmlinux"
-echo "kernel release: $(make -s O=$OUT kernelrelease 2>/dev/null || true)"
-
-# ---------------------------------------------------------------------------
-# Verify the audio stack really made it into the image.  A correct build shows
-# non-zero counts for all of these; the old TECHPACK=n build showed 0 for the
-# audio stack and only the camera strings.
-# ---------------------------------------------------------------------------
-if [ -f "$OUT/arch/arm64/boot/Image.gz" ]; then
-  echo "== audio stack inside Image.gz =="
-  gzip -dc "$OUT/arch/arm64/boot/Image.gz" > /tmp/_img_check
-  for s in adsp-loader q6afe bolero wcd937x wsa wcd_mbhc aw882xx \
-           sm6150-wcd9375-snd-card driver/BackCamera_info; do
-    printf "  %-28s %s\n" "$s" "$(grep -a -c "$s" /tmp/_img_check)"
-  done
-  rm -f /tmp/_img_check
-fi
diff --git a/s6patch触摸/0001-focaltech-msm-drm-notifier.patch b/s6patch触摸/0001-focaltech-msm-drm-notifier.patch
deleted file mode 100755
index 602104481..000000000
--- a/s6patch触摸/0001-focaltech-msm-drm-notifier.patch
+++ /dev/null
@@ -1,178 +0,0 @@
-[PATCH 1/1] input: focaltech_touch: register the MSM DRM notifier, not fb_notifier
-
-Symptom (real device): after locking the screen the system becomes extremely
-laggy, and the logs are full of erratic touch reports.
-
-Root cause
-----------
-The driver selects its display-blank notifier with
-
-    #if defined(CONFIG_FB)
-        ... fb_notifier_callback / fb_register_client(&ts_data->fb_notif)
-    #elif defined(CONFIG_DRM)
-        #if defined(CONFIG_DRM_PANEL)
-            ... drm_panel_notifier_register(active_panel, ...)
-        #else
-            ... msm_drm_register_client(&ts_data->fb_notif)
-        #endif
-    #endif
-
-This kernel has CONFIG_FB=y *and* CONFIG_DRM=y, and the display is MSM DRM
-(SDE).  The first branch therefore wins and the driver registers the legacy
-fb_notifier - which an MSM DRM display never fires.  verified in this tree:
-
-    drivers/gpu/drm/msm/msm_atomic.c:266  msm_drm_notifier_call_chain(MSM_DRM_EARLY_EVENT_BLANK, ...)
-    drivers/gpu/drm/msm/msm_atomic.c:287  msm_drm_notifier_call_chain(MSM_DRM_EVENT_BLANK, ...)
-
-so fts_ts_suspend()/fts_ts_resume() - whose only callers are these notifier
-callbacks - were NEVER called.  With the screen off the touch controller was
-left awake with its IRQ enabled:
-
-  * the IRQ keeps firing and every event runs the threaded handler, which does
-    i2c reads -> the CPU is woken continuously (the "very laggy after locking"
-    symptom);
-  * whatever the handler happens to read gets reported as touch points -> the
-    "erratic touch reports" symptom.
-
-The other two mechanism in the driver (the FB/DRM notifier and the early-suspend
-hook) are the only suspend paths; there is no dev_pm_ops on the i2c driver:
-
-    #if defined(CONFIG_PM) && FTS_PATCH_COMERR_PM     /* FTS_PATCH_COMERR_PM == 0 */
-        .pm = &fts_dev_pm_ops,
-    #endif
-
-so nothing else put the controller to sleep either.
-
-Fix
----
-Discriminate on CONFIG_FB_MSM (the legacy MSM framebuffer), exactly like
-drivers/input/touchscreen/st/fts.c does in this tree, and register the MSM DRM
-client, exactly like drivers/input/touchscreen/hxchipset/himax_common.c does:
-
-    #ifdef CONFIG_DRM
-        ts->fb_notif.notifier_call = drm_notifier_callback;
-        ret = msm_drm_register_client(&ts->fb_notif);
-
-This also fixes the header selection: linux/msm_drm_notify.h was only included
-in the (unreachable) CONFIG_DRM_PANEL #else branch, and the DRM_PANEL variant of
-drm_notifier_callback (which matches DRM_PANEL_* events) is now excluded - the
-MSM_DRM variant matching MSM_DRM_* events is the correct one for
-msm_drm_register_client().
-
-Verified: builds clean (no warnings), and the resulting Image.gz contains the
-new strings ("msm_drm notifier registered for blank/unblank",
-"Unable to register msm_drm notifier") while the fb path strings are gone.
---- a/drivers/input/touchscreen/focaltech_touch/focaltech_core.c
-+++ b/drivers/input/touchscreen/focaltech_touch/focaltech_core.c
-@@ -37,15 +37,28 @@
- #include <linux/of_device.h>
- #include <linux/of_gpio.h>
- #include <linux/of_irq.h>
--#if defined(CONFIG_FB)
-+/*
-+ * EEBBK S6 (P20H130) fix:
-+ * This kernel has CONFIG_FB=y *and* CONFIG_DRM=y, while the display is driven
-+ * by MSM DRM (SDE).  The original "#if defined(CONFIG_FB)" therefore registered
-+ * the legacy fb_notifier, which an MSM DRM display never fires, so
-+ * fts_ts_suspend()/fts_ts_resume() were never called.  With the screen off the
-+ * touch controller stayed awake with its IRQ enabled, which produced an
-+ * interrupt storm (system extremely laggy after locking) and bogus touch
-+ * reports.
-+ *
-+ * Other drivers in this tree use the MSM DRM client for this display
-+ * (hxchipset/himax_common.c: "#ifdef CONFIG_DRM ... msm_drm_register_client"),
-+ * and st/fts.c only takes the fb path when CONFIG_FB_MSM (legacy MSM
-+ * framebuffer) is set.  Apply the same rule here.
-+ */
-+#if defined(CONFIG_FB_MSM)
- #include <linux/notifier.h>
- #include <linux/fb.h>
--#elif defined(CONFIG_DRM)
--#if defined(CONFIG_DRM_PANEL)
--#include <drm/drm_panel.h>
--#else
-+#elif defined(CONFIG_DRM) || defined(CONFIG_MSM_DRM)
-+/* this display is MSM DRM (SDE): it notifies via the msm_drm chain */
-+#include <linux/notifier.h>
- #include <linux/msm_drm_notify.h>
--#endif
- #elif defined(CONFIG_HAS_EARLYSUSPEND)
- #include <linux/earlysuspend.h>
- #define FTS_SUSPEND_LEVEL 1     /* Early-suspend level */
-@@ -1494,7 +1507,7 @@ static void fts_resume_work(struct work_struct *work)
-     fts_ts_resume(ts_data->dev);
- }
- 
--#if defined(CONFIG_FB)
-+#if defined(CONFIG_FB_MSM)
- static int fb_notifier_callback(struct notifier_block *self,
-                                 unsigned long event, void *data)
- {
-@@ -1538,8 +1551,9 @@ static int fb_notifier_callback(struct notifier_block *self,
- 
-     return 0;
- }
--#elif defined(CONFIG_DRM)
--#if defined(CONFIG_DRM_PANEL)
-+#elif defined(CONFIG_DRM) || defined(CONFIG_MSM_DRM)
-+#if 0 /* EEBBK S6: the MSM DRM display never emits DRM_PANEL blank
-+         * events - use the MSM_DRM callback of the #else branch */
- static struct drm_panel *active_panel;
- 
- static int drm_check_dt(struct device_node *np)
-@@ -1824,26 +1838,21 @@ static int fts_ts_probe_entry(struct fts_ts_data *ts_data)
-     ts_data->pm_suspend = false;
- #endif
- 
--#if defined(CONFIG_FB)
-+#if defined(CONFIG_FB_MSM)
-     ts_data->fb_notif.notifier_call = fb_notifier_callback;
-     ret = fb_register_client(&ts_data->fb_notif);
-     if (ret) {
-         FTS_ERROR("[FB]Unable to register fb_notifier: %d", ret);
-     }
--#elif defined(CONFIG_DRM)
-+#elif defined(CONFIG_DRM) || defined(CONFIG_MSM_DRM)
-     ts_data->fb_notif.notifier_call = drm_notifier_callback;
--#if defined(CONFIG_DRM_PANEL)
--    if (active_panel) {
--        ret = drm_panel_notifier_register(active_panel, &ts_data->fb_notif);
--        if (ret)
--            FTS_ERROR("[DRM]drm_panel_notifier_register fail: %d\n", ret);
--    }
--#else
-+    /* EEBBK S6: register the MSM DRM client (the drm_panel notifier
-+     * used before is never notified on this display) */
-     ret = msm_drm_register_client(&ts_data->fb_notif);
--    if (ret) {
--        FTS_ERROR("[DRM]Unable to register fb_notifier: %d\n", ret);
--    }
--#endif
-+    if (ret)
-+        FTS_ERROR("[DRM]Unable to register msm_drm notifier: %d\n", ret);
-+    else
-+        FTS_INFO("[DRM]msm_drm notifier registered for blank/unblank");
- #elif defined(CONFIG_HAS_EARLYSUSPEND)
-     ts_data->early_suspend.level = EARLY_SUSPEND_LEVEL_BLANK_SCREEN + FTS_SUSPEND_LEVEL;
-     ts_data->early_suspend.suspend = fts_ts_early_suspend;
-@@ -1914,17 +1923,12 @@ static int fts_ts_remove_entry(struct fts_ts_data *ts_data)
-     if (ts_data->ts_workqueue)
-         destroy_workqueue(ts_data->ts_workqueue);
- 
--#if defined(CONFIG_FB)
-+#if defined(CONFIG_FB_MSM)
-     if (fb_unregister_client(&ts_data->fb_notif))
-         FTS_ERROR("[FB]Error occurred while unregistering fb_notifier.");
--#elif defined(CONFIG_DRM)
--#if defined(CONFIG_DRM_PANEL)
--    if (active_panel)
--        drm_panel_notifier_unregister(active_panel, &ts_data->fb_notif);
--#else
-+#elif defined(CONFIG_DRM) || defined(CONFIG_MSM_DRM)
-     if (msm_drm_unregister_client(&ts_data->fb_notif))
--        FTS_ERROR("[DRM]Error occurred while unregistering fb_notifier.\n");
--#endif
-+        FTS_ERROR("[DRM]Error unregistering msm_drm notifier.\n");
- #elif defined(CONFIG_HAS_EARLYSUSPEND)
-     unregister_early_suspend(&ts_data->early_suspend);
- #endif
diff --git a/s6patch霍尔/0001-input-misc-Add-the-iSentek-IST8801-hall-switch-drive.patch b/s6patch霍尔/0001-input-misc-Add-the-iSentek-IST8801-hall-switch-drive.patch
deleted file mode 100644
index d8409d76d..000000000
--- a/s6patch霍尔/0001-input-misc-Add-the-iSentek-IST8801-hall-switch-drive.patch
+++ /dev/null
@@ -1,514 +0,0 @@
-From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
-From: Zhiyu722 <Zhiyu722@users.noreply.github.com>
-Date: Sat, 12 Sep 2026 21:50:01 +0800
-Subject: [PATCH] input: misc: Add the iSentek IST8801 hall switch driver
-
-The EEBBK S6 carries iSentek IST8801 3D hall-effect switches on i2c 0x18 and
-0x1b (dt compatibles isentek,ist8801-0/-1/-2).  The vendor driver is built into
-the factory kernel and its source is not part of this tree, so the register map
-and the access protocol had to be recovered by disassembling the factory boot
-image, whose kallsyms still carries the symbol names (ist8801_i2c_probe,
-ist8801_i2c_read_block, ist8801_set_operation_mode, ist8801_hall_getdata, ...).
-
-  i2c write: buf[0] = reg, buf[1] = value, i2c_master_send(client, buf, 2)
-  i2c read : msg[0] = {addr, 0, 1, &reg}, msg[1] = {addr, I2C_M_RD, len, buf}
-             (len <= 0x11; serialised by a driver-global mutex)
-
-  reg 0x01 control, 0x07 control, 0x08 operation mode (0x00 powerdown /
-  0x40 measurement / 0x80 start), 0x09 device id, 0x10 five-byte data block,
-  0x20 control, 0x40 status, 0x54 status
-
-The device is brought up in measurement mode and exports data/enable/delay/
-vendor sysfs attributes; reading "data" triggers one measurement.  The BBK hall
-core and the elevator driver that consume it are still to be written.
-
-Signed-off-by: Zhiyu722 <Zhiyu722@users.noreply.github.com>
----
- drivers/input/misc/Kconfig   |  10 +
- drivers/input/misc/Makefile  |   1 +
- drivers/input/misc/ist8801.c | 449 +++++++++++++++++++++++++++++++++++
- 3 files changed, 460 insertions(+)
- create mode 100755 drivers/input/misc/ist8801.c
-
-diff --git a/drivers/input/misc/Kconfig b/drivers/input/misc/Kconfig
-index e0c7a6f35..cb7922e1b 100644
---- a/drivers/input/misc/Kconfig
-+++ b/drivers/input/misc/Kconfig
-@@ -890,3 +890,13 @@ config INPUT_HISI_POWERKEY
- 	  module will be called hisi_powerkey.
- 
- endif
-+
-+config INPUT_IST8801
-+	bool "iSentek IST8801 3D hall switch"
-+	depends on I2C
-+	help
-+	  Say Y here to support the iSentek IST8801 3D hall-effect switch used as
-+	  the BBK hall sensor (dt: isentek,ist8801-0/-1/-2).
-+
-+	  The driver was reconstructed from the vendor kernel binary because the
-+	  vendor sources are not part of this tree.
-diff --git a/drivers/input/misc/Makefile b/drivers/input/misc/Makefile
-index 137da08f7..769323298 100644
---- a/drivers/input/misc/Makefile
-+++ b/drivers/input/misc/Makefile
-@@ -85,3 +85,4 @@ obj-$(CONFIG_INPUT_WM831X_ON)		+= wm831x-on.o
- obj-$(CONFIG_INPUT_XEN_KBDDEV_FRONTEND)	+= xen-kbdfront.o
- obj-$(CONFIG_INPUT_YEALINK)		+= yealink.o
- obj-$(CONFIG_INPUT_IDEAPAD_SLIDEBAR)	+= ideapad_slidebar.o
-+obj-$(CONFIG_INPUT_IST8801)	+= ist8801.o
-diff --git a/drivers/input/misc/ist8801.c b/drivers/input/misc/ist8801.c
-new file mode 100755
-index 000000000..cb4b317a7
---- /dev/null
-+++ b/drivers/input/misc/ist8801.c
-@@ -0,0 +1,449 @@
-+/*
-+ * iSentek IST8801 3D hall-effect switch driver for the EEBBK S6 (P20H130).
-+ *
-+ * Reconstructed from the vendor kernel binary in the factory boot image: the
-+ * vendor source of this driver is not part of this tree, so the register map
-+ * and the access protocol were recovered by disassembling the factory Image
-+ * (its kallsyms still carries the symbol names).
-+ *
-+ * Recovered symbols
-+ *   ist8801_i2c_probe, ist8801_i2c_read_block, ist8801_set_operation_mode,
-+ *   ist8801_set_detection_mode, ist8801_hall_enable, ist8801_hall_getdata,
-+ *   ist8801_get_data, ist8801_get_id, ist8801_reset_device,
-+ *   ist8801_dump_reg, ist8801_i2c_suspend/resume, ist8801_ranges_1/_2
-+ *
-+ * I2C protocol
-+ *   write: buf[0] = reg, buf[1] = value, i2c_master_send(client, buf, 2),
-+ *          serialised by the global ist8801_i2c_mutex.
-+ *   read : ist8801_i2c_read_block(data, reg, buf, len), len <= 0x11,
-+ *          i2c_transfer with {addr,0,1,&reg} then {addr,I2C_M_RD,len,buf}.
-+ *
-+ * Register map (addresses seen in the disassembly)
-+ *   0x01  control             written 0x00 (also on the reset path)
-+ *   0x07  control             written 0x01
-+ *   0x08  operation mode      written 0x00 powerdown / 0x40 mode / 0x80 start
-+ *   0x09  device id           read twice with msleep(20) in between
-+ *   0x10  5-byte data block   "ist8801: data [%02X, %02X, %02X, %02X, %02X]"
-+ *   0x20  control             written 0x00 / 0x02
-+ *   0x40  status/mode         read 1 byte before and after a measurement
-+ *   0x54  status              read 1 byte
-+ *   0x00..0x13                dumped by ist8801_dump_reg
-+ *
-+ * Data path
-+ *   ist8801_hall_enable -> set_detection_mode + set_operation_mode
-+ *   ist8801_hall_getdata: read 0x40; write {0x08,0x80};
-+ *                         usleep_range(2000, 2500); read 5 bytes @0x10;
-+ *                         read 0x40 again; log "z=%6d, zc=%6d, t=%6d, t25=%6d"
-+ *
-+ * SPDX-License-Identifier: GPL-2.0
-+ */
-+#include <linux/module.h>
-+#include <linux/i2c.h>
-+#include <linux/of.h>
-+#include <linux/of_device.h>
-+#include <linux/slab.h>
-+#include <linux/delay.h>
-+#include <linux/mutex.h>
-+#include <linux/sysfs.h>
-+#include <linux/string.h>
-+
-+#define IST8801_DRV_NAME	"ist8801"
-+
-+#define IST8801_REG_CTRL1	0x01
-+#define IST8801_REG_CTRL2	0x07
-+#define IST8801_REG_OPMODE	0x08
-+#define IST8801_REG_DID		0x09
-+#define IST8801_REG_DATA	0x10
-+#define IST8801_REG_CTRL3	0x20
-+#define IST8801_REG_STATUS1	0x40
-+#define IST8801_REG_STATUS2	0x54
-+
-+#define IST8801_OP_POWERDOWN	0x00
-+#define IST8801_OP_MODE		0x40
-+#define IST8801_OP_START	0x80
-+
-+#define IST8801_DATA_LEN	5
-+#define IST8801_MAX_RD		0x11
-+
-+struct ist8801_data {
-+	struct i2c_client	*client;
-+	struct device		*dev;
-+	struct mutex		lock;
-+	u8			did;
-+	bool			enabled;
-+	unsigned int		delay_ms;
-+	u32			data_range;
-+	u32			bias_support;
-+	u32			bias_ratio;
-+	char			line[128];
-+};
-+
-+static DEFINE_MUTEX(ist8801_i2c_mutex);
-+
-+static int ist8801_i2c_read_block(struct ist8801_data *d, u8 reg, u8 *buf, u16 len)
-+{
-+	struct i2c_msg msgs[2];
-+	int ret;
-+
-+	if (!d || !d->client)
-+		return -EINVAL;
-+	if (!len || len > IST8801_MAX_RD) {
-+		dev_err(d->dev, "%s: bad length %u\n", __func__, len);
-+		return -EINVAL;
-+	}
-+
-+	mutex_lock(&ist8801_i2c_mutex);
-+	msgs[0].addr = d->client->addr;
-+	msgs[0].flags = 0;
-+	msgs[0].len = 1;
-+	msgs[0].buf = &reg;
-+	msgs[1].addr = d->client->addr;
-+	msgs[1].flags = I2C_M_RD;
-+	msgs[1].len = len;
-+	msgs[1].buf = buf;
-+	ret = i2c_transfer(d->client->adapter, msgs, 2);
-+	mutex_unlock(&ist8801_i2c_mutex);
-+
-+	if (ret < 0) {
-+		dev_err(d->dev, "%s: i2c read reg 0x%02x failed (%d)\n",
-+			__func__, reg, ret);
-+		return -EIO;
-+	}
-+	return 0;
-+}
-+
-+static int ist8801_i2c_write_block(struct ist8801_data *d, u8 reg, u8 val)
-+{
-+	u8 buf[2] = { reg, val };
-+	int ret;
-+
-+	if (!d || !d->client)
-+		return -EINVAL;
-+
-+	mutex_lock(&ist8801_i2c_mutex);
-+	ret = i2c_master_send(d->client, buf, sizeof(buf));
-+	mutex_unlock(&ist8801_i2c_mutex);
-+
-+	if (ret < 0) {
-+		dev_err(d->dev, "%s: i2c write 0x%02x=0x%02x failed (%d)\n",
-+			__func__, reg, val, ret);
-+		return -EIO;
-+	}
-+	return 0;
-+}
-+
-+static int ist8801_reset_device(struct ist8801_data *d)
-+{
-+	int ret = ist8801_i2c_write_block(d, IST8801_REG_CTRL1, 0x00);
-+
-+	msleep(20);	/* the factory probe sleeps 20ms before re-reading the id */
-+	return ret;
-+}
-+
-+static int ist8801_get_id(struct ist8801_data *d, u8 *id)
-+{
-+	return ist8801_i2c_read_block(d, IST8801_REG_DID, id, 1);
-+}
-+
-+static int ist8801_set_operation_mode(struct ist8801_data *d, u8 op)
-+{
-+	int ret;
-+
-+	switch (op) {
-+	case IST8801_OP_START:
-+		ret = ist8801_i2c_write_block(d, IST8801_REG_OPMODE, IST8801_OP_START);
-+		break;
-+	case IST8801_OP_MODE:
-+		ret = ist8801_i2c_write_block(d, IST8801_REG_OPMODE, IST8801_OP_MODE);
-+		if (!ret)
-+			ret = ist8801_i2c_write_block(d, IST8801_REG_CTRL3, 0x02);
-+		break;
-+	default:
-+		ret = ist8801_i2c_write_block(d, IST8801_REG_OPMODE, IST8801_OP_POWERDOWN);
-+		if (!ret)
-+			ret = ist8801_i2c_write_block(d, IST8801_REG_CTRL3, 0x00);
-+		break;
-+	}
-+	return ret;
-+}
-+
-+static int ist8801_set_detection_mode(struct ist8801_data *d, bool enable)
-+{
-+	return ist8801_i2c_write_block(d, IST8801_REG_CTRL1, enable ? 0x01 : 0x00);
-+}
-+
-+static int ist8801_get_data(struct ist8801_data *d, u8 *raw)
-+{
-+	int ret;
-+
-+	ret = ist8801_i2c_read_block(d, IST8801_REG_STATUS1, raw, 1);
-+	if (ret)
-+		return ret;
-+
-+	ret = ist8801_set_operation_mode(d, IST8801_OP_START);
-+	if (ret)
-+		return ret;
-+
-+	usleep_range(2000, 2500);
-+
-+	ret = ist8801_i2c_read_block(d, IST8801_REG_DATA, raw, IST8801_DATA_LEN);
-+	if (ret)
-+		return ret;
-+
-+	dev_dbg(d->dev, "%s: data [%02X, %02X, %02X, %02X, %02X]\n", __func__,
-+		raw[0], raw[1], raw[2], raw[3], raw[4]);
-+
-+	if (!(raw[0] & 0x01))
-+		dev_dbg(d->dev, "%s: st1(0x%02X) is not DRDY.\n", __func__, raw[0]);
-+
-+	return 0;
-+}
-+
-+/* one full sample, formatted the way the factory driver formatted it */
-+static int ist8801_refresh(struct ist8801_data *d)
-+{
-+	u8 raw[IST8801_DATA_LEN];
-+	u8 st2 = 0;
-+	s16 z, t;
-+	int ret;
-+
-+	mutex_lock(&d->lock);
-+	ret = ist8801_get_data(d, raw);
-+	mutex_unlock(&d->lock);
-+	if (ret)
-+		return ret;
-+
-+	z = (s16)((raw[2] << 8) | raw[1]);
-+	t = (s16)((raw[4] << 8) | raw[3]);
-+
-+	ist8801_i2c_read_block(d, IST8801_REG_STATUS2, &st2, 1);
-+
-+	scnprintf(d->line, sizeof(d->line),
-+		  "ist8801 [%x], z=%6d, zc=%6d, t=%6d, t25=%6d.",
-+		  d->client->addr, z, z, t, t);
-+	return 0;
-+}
-+
-+static ssize_t data_show(struct device *dev, struct device_attribute *attr, char *buf)
-+{
-+	struct ist8801_data *d = dev_get_drvdata(dev);
-+
-+	ist8801_refresh(d);
-+	return scnprintf(buf, PAGE_SIZE, "%s\n", d->line);
-+}
-+
-+static ssize_t enable_show(struct device *dev, struct device_attribute *attr, char *buf)
-+{
-+	struct ist8801_data *d = dev_get_drvdata(dev);
-+
-+	return scnprintf(buf, PAGE_SIZE, "%d\n", d->enabled ? 1 : 0);
-+}
-+
-+static ssize_t enable_store(struct device *dev, struct device_attribute *attr,
-+			    const char *buf, size_t count)
-+{
-+	struct ist8801_data *d = dev_get_drvdata(dev);
-+	unsigned long v;
-+
-+	if (kstrtoul(buf, 0, &v))
-+		return -EINVAL;
-+
-+	mutex_lock(&d->lock);
-+	d->enabled = !!v;
-+	ist8801_set_detection_mode(d, d->enabled);
-+	ist8801_set_operation_mode(d, d->enabled ? IST8801_OP_MODE
-+						 : IST8801_OP_POWERDOWN);
-+	mutex_unlock(&d->lock);
-+	return count;
-+}
-+
-+static ssize_t delay_show(struct device *dev, struct device_attribute *attr, char *buf)
-+{
-+	struct ist8801_data *d = dev_get_drvdata(dev);
-+
-+	return scnprintf(buf, PAGE_SIZE, "%u\n", d->delay_ms);
-+}
-+
-+static ssize_t delay_store(struct device *dev, struct device_attribute *attr,
-+			   const char *buf, size_t count)
-+{
-+	struct ist8801_data *d = dev_get_drvdata(dev);
-+	unsigned long v;
-+
-+	if (kstrtoul(buf, 0, &v))
-+		return -EINVAL;
-+	d->delay_ms = (unsigned int)v;
-+	return count;
-+}
-+
-+static ssize_t vendor_show(struct device *dev, struct device_attribute *attr, char *buf)
-+{
-+	return scnprintf(buf, PAGE_SIZE, "isentek\n");
-+}
-+
