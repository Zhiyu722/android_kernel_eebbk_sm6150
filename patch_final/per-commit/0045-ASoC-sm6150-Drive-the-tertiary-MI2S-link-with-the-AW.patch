From d799367d8798995fd058597b8ae44cfc2997e1df Mon Sep 17 00:00:00 2001
From: Zhiyu722 <Zhiyu722@users.noreply.github.com>
Date: Fri, 18 Sep 2026 18:01:42 +0800
Subject: [PATCH 45/73] ASoC: sm6150: Drive the tertiary MI2S link with the
 AW882xx codec

The ROM's mixer paths send speaker playback to the tertiary MI2S backend
("TERT_MI2S_RX Audio Mixer MultiMedia5") and its HAL registers the speaker
device on it, but this table named msm-stub-codec.1 there.  A stub has no DAI
events, so the AWINIC AW882xx amplifiers on that port were never started: their
SYSCTRL register (0x04) stayed at 0x4003 - PWDN and AMPPD set - through every
playback.  Point the link at the same awinic_codecs components the primary MI2S
link already uses (the device tree gives both amplifiers on i2c 2-0034 and
2-0036), after which the driver's startup, hw_params, mute and power up sequence
all run and the chip leaves power down while audio plays.

Signed-off-by: Zhiyu722 <Zhiyu722@users.noreply.github.com>
---
 techpack/audio/asoc/sm6150.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/techpack/audio/asoc/sm6150.c b/techpack/audio/asoc/sm6150.c
index bef9465a0..dcdbe7734 100755
--- a/techpack/audio/asoc/sm6150.c
+++ b/techpack/audio/asoc/sm6150.c
@@ -7784,8 +7784,25 @@ static struct snd_soc_dai_link msm_mi2s_be_dai_links[] = {
 		.stream_name = "Tertiary MI2S Playback",
 		.cpu_dai_name = "msm-dai-q6-mi2s.2",
 		.platform_name = "msm-pcm-routing",
+#ifdef CONFIG_SND_SOC_AWINIC_AW882XX
+		/*
+		 * EEBBK S6 (P20H130): the speaker is driven by the two AWINIC
+		 * AW882xx amplifiers on the tertiary MI2S port.  The ROM's
+		 * mixer paths route speaker playback with
+		 * "TERT_MI2S_RX Audio Mixer MultiMedia5" and its HAL registers
+		 * the speaker device on this backend, but this table used to
+		 * name msm-stub-codec.1 here.  A stub has no DAI events, so
+		 * the amplifiers were never taken out of power down: reading
+		 * the chip showed SYSCTRL (0x04) stuck at 0x4003 - PWDN and
+		 * AMPPD set - through every playback, and the speaker stayed
+		 * silent even after the PCM started without error.
+		 */
+		.num_codecs = ARRAY_SIZE(awinic_codecs),
+		.codecs = awinic_codecs,
+#else
 		.codec_name = "msm-stub-codec.1",
 		.codec_dai_name = "msm-stub-rx",
+#endif
 		.no_pcm = 1,
 		.dpcm_playback = 1,
 		.id = MSM_BACKEND_DAI_TERTIARY_MI2S_RX,
